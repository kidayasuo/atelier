// 育ち舎のプレゼン：Illustratorの割付スクリプトの共通部分（build / export / update が #include する）
// ExtendScript（ES3）で書く：let・const・アロー関数・JSONオブジェクトは使わない。
var SDY = {};
SDY.K = 72 / 25.4;                                   // mm → pt
SDY.here = File($.fileName).parent;                  // present/ai
SDY.root = SDY.here.parent.parent;                   // sodachiya

SDY.readText = function (f) {
    f.encoding = "UTF-8";
    if (!f.open("r")) { throw new Error("開けない: " + f.fsName); }
    var t = f.read(); f.close();
    if (t.charCodeAt(0) === 0xFEFF) { t = t.substring(1); }
    return t;
};
SDY.readJSON = function (f) { return eval("(" + SDY.readText(f) + ")"); };   // 自分たちのファイルだけを読む
SDY.writeText = function (f, t) {
    f.encoding = "UTF-8"; f.lineFeed = "Unix";
    if (!f.open("w")) { throw new Error("書けない: " + f.fsName); }
    f.write(t); f.close();
};
SDY.q = function (s) {
    var o = '"', i, c, h;
    for (i = 0; i < s.length; i++) {
        c = s.charAt(i); h = s.charCodeAt(i);
        if (c === '"') { o += '\\"'; } else if (c === "\\") { o += "\\\\"; }
        else if (c === "\n") { o += "\\n"; } else if (c === "\r") { o += "\\n"; } else if (c === "\t") { o += "\\t"; }
        else if (h < 32 || h === 0x2028 || h === 0x2029) { o += "\\u" + ("0000" + h.toString(16)).slice(-4); }
        else { o += c; }
    }
    return o + '"';
};
SDY.stringify = function (v, ind) {
    ind = ind || "";
    var t = typeof v, out, k, i, a;
    if (v === null || v === undefined) { return "null"; }
    if (t === "number") { return isFinite(v) ? String(Math.round(v * 100) / 100) : "null"; }
    if (t === "boolean") { return v ? "true" : "false"; }
    if (t === "string") { return SDY.q(v); }
    if (v instanceof Array) {
        a = [];
        for (i = 0; i < v.length; i++) { a.push(SDY.stringify(v[i], ind + " ")); }
        return "[" + a.join(", ") + "]";
    }
    a = [];
    for (k in v) { if (v.hasOwnProperty(k)) { a.push(ind + " " + SDY.q(k) + ": " + SDY.stringify(v[k], ind + " ")); } }
    return "{\n" + a.join(",\n") + "\n" + ind + "}";
};
// 文字の印（mock.py の ai_layout.djb2 と同じ）：書き換えたかどうかを見るため
SDY.norm = function (s) { s = String(s).replace(/\r\n?/g, "\n").replace(/\u0003/g, "\n"); return s.replace(/\n+$/, ""); };
SDY.hash = function (s) {
    s = SDY.norm(s);
    var h = 5381, i;
    for (i = 0; i < s.length; i++) { h = (h * 33 + s.charCodeAt(i)) % 4294967296; }
    return h.toString(16);
};
SDY.rgb = function (hex) {
    var c = new RGBColor();
    hex = String(hex || "#222222").replace("#", "");
    c.red = parseInt(hex.substr(0, 2), 16); c.green = parseInt(hex.substr(2, 2), 16); c.blue = parseInt(hex.substr(4, 2), 16);
    return c;
};
// グローバルスウォッチ（ゾーニングの分類の色、10-31 22:23）：名前のスウォッチが無ければ作る。スウォッチの色を変えれば同じ分類の面がみな変わる。
// 作れなければ RGB のまま（同じ値なので「同じ塗りを選択」で選べる）
SDY.swatchColor = function (name, hex) {
    if (!name) { return SDY.rgb(hex); }
    try {
        var doc = app.activeDocument, sp = null, k;
        for (k = 0; k < doc.spots.length; k++) { if (doc.spots[k].name === name) { sp = doc.spots[k]; break; } }
        if (!sp) { sp = doc.spots.add(); sp.name = name; sp.colorType = ColorModel.PROCESS; sp.color = SDY.rgb(hex); }
        var sc = new SpotColor(); sc.spot = sp; sc.tint = 100;
        return sc;
    } catch (e) { return SDY.rgb(hex); }
};
SDY.fontCache = {};
SDY.font = function (w) {
    if (SDY.fontCache[w] !== undefined) { return SDY.fontCache[w]; }
    var names = (w === "W6") ? ["HiraginoSans-W6", "HiraKakuProN-W6", "HiraKakuPro-W6", "HiraginoSans-W5"]
              : (w === "W3" || !w) ? ["HiraginoSans-W3", "HiraKakuProN-W3", "HiraKakuPro-W3", "HiraginoSans-W2"]
              : [w, w.replace(/-/g, ""), "Apple Chancery", "HiraginoSans-W3"];          // 名前で（Apple-Chancery など、無ければヒラギノ）
    var i, f = null;
    for (i = 0; i < names.length && !f; i++) { try { f = app.textFonts.getByName(names[i]); } catch (e) { f = null; } }
    SDY.fontCache[w] = f;
    return f;
};
SDY.layer = function (doc, name) {
    try { return doc.layers.getByName(name); } catch (e) {
        var l = doc.layers.add(); l.name = name;
        // ゾーニングの白地図のレイヤー（10-31）：図より上、文字（説明）より下。後から作るときも「説明」のすぐ下へ（境界→上の線の順に作ると上の線が上）
        if (name.indexOf("ゾーニング") === 0) { try { l.move(doc.layers.getByName("説明"), ElementPlacement.PLACEAFTER); } catch (e2) {} }
        return l;
    }
};
SDY.ab = function (doc, i) { return doc.artboards[i].artboardRect; };            // [左, 上, 右, 下]（pt、ドキュメント座標、yは上へ）
SDY.P = function (doc, i, x, y) { var r = SDY.ab(doc, i); return [r[0] + x * SDY.K, r[1] - y * SDY.K]; };
SDY.abOf = function (doc, b) {                                                     // 物の外形 b から、どのアートボードか
    if (!b || b.length < 4) { return -1; }
    var cx = (b[0] + b[2]) / 2, cy = (b[1] + b[3]) / 2, i, r;
    for (i = 0; i < doc.artboards.length; i++) {
        r = doc.artboards[i].artboardRect;
        if (cx >= r[0] && cx <= r[2] && cy <= r[1] && cy >= r[3]) { return i; }
    }
    return -1;
};
SDY.tag = function (it, p) {
    it.name = p.name || p.id;
    it.note = "sdy:" + p.kind + "|" + p.id + "|" + (p.mock_hash || "");
};
SDY.parseTag = function (it) {
    var n = "";
    try { n = it.note; } catch (e) { return null; }
    if (!n || n.indexOf("sdy:") !== 0) { return null; }
    var a = n.substring(4).split("|");
    return { kind: a[0], id: a[1], mock_hash: a[2] || "" };
};
// 文字の体裁。Illustratorは文字の範囲によって Error 9503（illegal text range）を出すことがあるので、
// 属性は一つずつ try で掛け、全体に掛けられなければ段落ごと・文字ごとに掛ける（10-25、ユーザーの試運転で9503）
SDY._each = function (tf, fn) {
    try { fn(tf.textRange); return; } catch (e0) {}
    var k, ok = false;
    try { for (k = 0; k < tf.paragraphs.length; k++) { try { if (tf.paragraphs[k].length > 0) { fn(tf.paragraphs[k]); ok = true; } } catch (e1) {} } } catch (e2) {}
    if (ok) { return; }
    try { for (k = 0; k < tf.characters.length; k++) { try { fn(tf.characters[k]); } catch (e3) {} } } catch (e4) {}
};
SDY.styleText = function (tf, p) {
    var f = SDY.font(p.font), size = Number(p.size_pt), lead = Number(p.leading || 1.5);
    if (!(size > 0.1 && size < 1296)) { size = 10; }
    var jus = (p.justify === "full_last_left") ? Justification.FULLJUSTIFYLASTLINELEFT :
              ((p.align === "center") ? Justification.CENTER : ((p.align === "right") ? Justification.RIGHT : Justification.LEFT));
    // 段落は両端揃え・最終行は左（ユーザー 10-25夕）、一字下げしない、段落のあいだは1行分、行送り＝文字の1.5倍
    SDY._each(tf, function (r) { r.characterAttributes.size = size; });
    if (f) { SDY._each(tf, function (r) { r.characterAttributes.textFont = f; }); }
    SDY._each(tf, function (r) { r.characterAttributes.fillColor = SDY.rgb(p.color); });
    SDY._each(tf, function (r) { r.characterAttributes.autoLeading = false; r.characterAttributes.leading = size * lead; });
    SDY._each(tf, function (r) { r.paragraphAttributes.justification = jus; });
    SDY._each(tf, function (r) { r.paragraphAttributes.firstLineIndent = 0; });
    if (p.para_space) { SDY._each(tf, function (r) { r.paragraphAttributes.spaceAfter = size * Number(p.para_space); }); }
    // 段落ごとの書式（3枚目の inspired by と面積表の列、10-29）：para_styles[k] = {size_pt, font, color, leading_pt}
    if (p.para_styles) {
        var k, pr, st;
        for (k = 0; k < p.para_styles.length; k++) {
            st = p.para_styles[k];
            try { pr = tf.paragraphs[k]; } catch (e5) { break; }
            if (!pr || !st) { continue; }
            try { if (pr.length === 0) { continue; } } catch (e6) {}
            try { if (st.size_pt) { pr.characterAttributes.size = Number(st.size_pt); } } catch (e7) {}
            try { var ff = SDY.font(st.font); if (ff) { pr.characterAttributes.textFont = ff; } } catch (e8) {}
            try { if (st.color) { pr.characterAttributes.fillColor = SDY.rgb(st.color); } } catch (e9) {}
            try { if (st.leading_pt) { pr.characterAttributes.autoLeading = false; pr.characterAttributes.leading = Number(st.leading_pt); } } catch (e10) {}
            if (st.tail) {                            // 段落の後ろの区間だけ別の書式（inspired by の名前の後ろの出どころ、10-30）
                try {
                    var tf_ = SDY.font(st.tail.font), j_;
                    for (j_ = st.tail.from; j_ < pr.characters.length; j_++) {
                        var ca_ = pr.characters[j_].characterAttributes;
                        if (st.tail.size_pt) { ca_.size = Number(st.tail.size_pt); }
                        if (tf_) { ca_.textFont = tf_; }
                        if (st.tail.color) { ca_.fillColor = SDY.rgb(st.tail.color); }
                    }
                } catch (e11) {}
            }
        }
    }
};
// 文字の書式（書体・大きさ・色・行送り）：.ai で変えた書式を書き出し、build・update_texts で当て直す（ユーザー 10-29 15:33）
SDY.fontName = function (f) { try { return f.name; } catch (e) { return null; } };
SDY.runsOf = function (tf) {                         // 段落ごとの、書式のそろった区間 [{para, off, len, font, size_pt, color, leading_pt}]
    var out = [], k, pr, n, j, c, a, cur = null, key, ca;
    for (k = 0; k < tf.paragraphs.length; k++) {
        try { pr = tf.paragraphs[k]; n = pr.characters.length; } catch (e) { continue; }
        cur = null;
        for (j = 0; j < n; j++) {
            try { c = pr.characters[j]; ca = c.characterAttributes; } catch (e1) { continue; }
            a = { font: SDY.fontName(ca.textFont), size_pt: Math.round(ca.size * 100) / 100, color: SDY.hexOf(ca.fillColor),
                  leading_pt: ca.autoLeading ? null : Math.round(ca.leading * 100) / 100 };
            key = a.font + "|" + a.size_pt + "|" + a.color + "|" + a.leading_pt;
            if (cur && cur.key === key) { cur.len++; continue; }
            cur = { key: key, para: k, off: j, len: 1, font: a.font, size_pt: a.size_pt, color: a.color, leading_pt: a.leading_pt };
            out.push(cur);
        }
    }
    for (k = 0; k < out.length; k++) { delete out[k].key; }
    return out;
};
SDY.expectStyle = function (p, k) {                  // layout.json の部品が決めた、段落 k の書式
    var st = (p.para_styles && p.para_styles[k]) || {}, f = SDY.font(st.font || p.font);
    var size = Number(st.size_pt || p.size_pt), lead = st.leading_pt ? Number(st.leading_pt) : size * Number(p.leading || 1.5);
    return { font: SDY.fontName(f), size_pt: Math.round(size * 100) / 100, color: String(st.color || p.color || "#222222").toLowerCase(), leading_pt: Math.round(lead * 100) / 100 };
};
SDY.styleDiff = function (tf, p) {                   // 書き出し：layout.json と違う区間だけ
    var runs = SDY.runsOf(tf), out = [], k, r, e;
    for (k = 0; k < runs.length; k++) {
        r = runs[k]; e = SDY.expectStyle(p, r.para);
        if (r.font !== e.font || Math.abs(r.size_pt - e.size_pt) > 0.05 || String(r.color).toLowerCase() !== e.color ||
            (r.leading_pt !== null && Math.abs(r.leading_pt - e.leading_pt) > 0.1)) { out.push(r); }
    }
    return out;
};
SDY.applyRuns = function (tf, runs, id) {            // 区間ごとに当てる。段落の番号で当て、段落が足りない・短いときは当てずに一覧へ
    var k, r, pr, j, ca, f, bad = 0;
    for (k = 0; k < (runs || []).length; k++) {
        r = runs[k];
        try { pr = tf.paragraphs[r.para]; } catch (e) { pr = null; }
        if (!pr || pr.characters.length < r.off + r.len) { bad++; continue; }
        f = null; if (r.font) { try { f = app.textFonts.getByName(r.font); } catch (e1) { f = null; } }
        for (j = r.off; j < r.off + r.len; j++) {
            try {
                ca = pr.characters[j].characterAttributes;
                if (f) { ca.textFont = f; }
                if (r.size_pt) { ca.size = Number(r.size_pt); }
                if (r.color) { var c = SDY.colorOf(r.color); if (c) { ca.fillColor = c; } }
                if (r.leading_pt) { ca.autoLeading = false; ca.leading = Number(r.leading_pt); }
            } catch (e2) {}
        }
    }
    if (bad) { SDY.missing.push("書式を当てられなかった（文が変わって段落が合わない）：" + id + "（" + bad + " か所）"); }
};
// 重ね順（ユーザー 10-29 17:39）：重ね順はレイヤーの中だけで効く。layout.json の order（グループ a を b の上に）と、
// 書き出した layout_user.json の stacking（レイヤーごとの、いちばん上の階の物の上からの並び）を build・update_texts の終わりに当てる
SDY.topOf = function (it) { var q = it; try { while (q.parent && q.parent.typename !== "Layer") { q = q.parent; } } catch (e) {} return q; };
SDY.firstTagIn = function (it) {                    // グループの中の、いちばん初めの印の付いた部品の id（無ければ null）
    var k, t, r;
    if (it.typename !== "GroupItem") { return null; }
    for (k = 0; k < it.pageItems.length; k++) {
        t = SDY.parseTag(it.pageItems[k]); if (t) { return t.id; }
        r = SDY.firstTagIn(it.pageItems[k]); if (r) { return r; }
    }
    return null;
};
SDY.firstUserIn = function (it) {                   // グループの中の、いちばん初めの木田さんの物の鍵
    var k, u, r;
    if (it.typename !== "GroupItem") { return null; }
    for (k = 0; k < it.pageItems.length; k++) {
        u = SDY.userKey(it.pageItems[k]); if (u) { return u; }
        r = SDY.firstUserIn(it.pageItems[k]); if (r) { return r; }
    }
    return null;
};
SDY.stackKey = function (it) {
    // レイヤーのすぐ下の物の鍵（10-30：レイヤーは完璧に覚える）。グループは中の印の付いた部品で覚える（名前は同じものがあり、変わることもある）
    var t = SDY.parseTag(it), u = SDY.userKey(it), d;
    if (t) { return "t:" + t.id; }
    if (u) { return "u:" + u; }
    if (it.typename === "GroupItem") {
        d = SDY.firstTagIn(it); if (d) { return "d:" + d; }
        d = SDY.firstUserIn(it); if (d) { return "e:" + d; }
        if (it.name) { return "g:" + it.name; }
    }
    return null;
};
SDY.stackingOf = function (doc, rid) {               // 書き出し：{レイヤーの名前: [鍵（上から）]}
    var out = {}, i, k, L, it, key, arr;
    for (i = 0; i < doc.layers.length; i++) {
        L = doc.layers[i]; arr = [];
        for (k = 0; k < L.pageItems.length; k++) {
            it = L.pageItems[k];
            try { if (it.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
            key = SDY.stackKey(it);
            if (key && (key.indexOf("t:") === 0 || key.indexOf("d:") === 0) && rid) { key = key.substring(0, 2) + rid(key.substring(2)); }
            if (key) { arr.push(key); }
        }
        if (arr.length) { out[L.name] = arr; }
    }
    return out;
};
SDY.findGroupTop = function (doc, name, lay) {       // いちばん上の階の、名前のグループ（レイヤーを指せばそのレイヤーを先に）
    var i, g, cand = null;
    for (i = 0; i < doc.groupItems.length; i++) {
        g = doc.groupItems[i];
        try { if (g.name !== name || g.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
        if (!lay || g.layer === lay) { return g; }
        if (!cand) { cand = g; }
    }
    return cand;
};
SDY.applyOrder = function (doc, L, onlyTops) {       // layout.json の order：{layer, name, above}（name のグループを above のグループのすぐ上に）。onlyTops を渡せば、その中の物だけ動かす（10-31：前からある物の重ね順に触れない）
    var k, r, lay, a, b, n = 0, m, hit;
    for (k = 0; k < ((L && L.order) || []).length; k++) {
        r = L.order[k];
        try {
            lay = SDY.layer(doc, r.layer);
            a = SDY.findGroupTop(doc, r.name, lay); b = SDY.findGroupTop(doc, r.above, lay);
            if (!a || !b) { continue; }
            if (onlyTops) { hit = false; for (m = 0; m < onlyTops.length; m++) { if (onlyTops[m] === a) { hit = true; break; } } if (!hit) { continue; } }
            if (a.layer !== lay) { a.move(lay, ElementPlacement.PLACEATBEGINNING); }
            if (b.layer !== lay) { continue; }
            a.move(b, ElementPlacement.PLACEBEFORE); n++;
        } catch (e) { SDY.missing.push("重ね順（" + r.name + "）：" + e.message); }
    }
    return n;
};
SDY.applyStacking = function (doc, U) {              // layout_user.json の stacking：書き出したときの並びに（レイヤーを移した物はそのレイヤーへ）
    if (!U || !U.stacking) { return 0; }
    var map = SDY.findByTag(doc), um = SDY.userKeys(doc), ln, arr, lay, k, key, it, n = 0;
    for (ln in U.stacking) {
        if (!U.stacking.hasOwnProperty(ln)) { continue; }
        arr = U.stacking[ln];
        try { lay = doc.layers.getByName(ln); } catch (e) { continue; }   // 編集モードなどの無いレイヤーは飛ばす
        for (k = arr.length - 1; k >= 0; k--) {                          // 下から順に上へ積む
            key = arr[k]; it = null;
            if (key.indexOf("t:") === 0 || key.indexOf("d:") === 0) { it = map[key.substring(2)]; }
            else if (key.indexOf("u:") === 0 || key.indexOf("e:") === 0) { it = um[key.substring(2)]; }
            else if (key.indexOf("g:") === 0) { it = SDY.findGroupTop(doc, key.substring(2), lay); }
            if (!it) { continue; }
            it = SDY.topOf(it);
            try { it.move(lay, ElementPlacement.PLACEATBEGINNING); n++; } catch (e1) {}
        }
    }
    return n;
};
SDY.missing = [];
// 作れなかった部品（10-30：編集モードで update_texts が作れなかった寸法を、書き出しが「消した」と記録した）。
// build・update_texts が failed_parts.json に書き、export_layout はそこにある部品を「消した」にしない
SDY.failed = {};
SDY.writeFailed = function () {
    var a = [], k; for (k in SDY.failed) { if (SDY.failed.hasOwnProperty(k)) { a.push(SDY.q(k)); } }
    try { SDY.writeText(File(SDY.here.fsName + "/failed_parts.json"), "[" + a.join(",") + "]\n"); } catch (e) {}
};
SDY.readFailed = function () {
    var m = {}, a, k; try { a = SDY.readJSON(File(SDY.here.fsName + "/failed_parts.json")); for (k = 0; k < a.length; k++) { m[a[k]] = true; } } catch (e) {}
    return m;
};
// 5枚の番号の振り直し（ユーザー、10-28・10-28 13:17）：layout.json の renumber.maps（前の番号 → 新しい番号）。
// 前に組んだときの layout_built.json の renumber の id で、今の .ai がどの番号かを見る（renumber が無ければ最初の番号＝"_none"）。
// 今の番号のままなら null、前の番号なら写し方（{"前": 新, …}）を返す
SDY.oldNumbering = function (L) {
    if (!L || !L.renumber || !L.renumber.maps) { return null; }
    var OB = null;
    try { var bf = File(SDY.here.fsName + "/layout_built.json"); if (bf.exists) { OB = SDY.readJSON(bf); } } catch (e) {}
    var was = (OB && OB.renumber) ? OB.renumber.id : "_none";
    if (was === L.renumber.id) { return null; }
    return L.renumber.maps[was] || null;
};
// 枚が分かれた部品（10-30、6枚）：layout.json の renumber.split（前に組んだときの id ごと、部品の名前の頭 → 新しい頭）。無ければ null
SDY.oldSplit = function (L) {
    if (!L || !L.renumber || !L.renumber.split || !SDY.oldNumbering(L)) { return null; }
    var OB = null;
    try { var bf = File(SDY.here.fsName + "/layout_built.json"); if (bf.exists) { OB = SDY.readJSON(bf); } } catch (e) {}
    var was = (OB && OB.renumber) ? OB.renumber.id : "_none";
    return L.renumber.split[was] || null;
};
// 前の番号の名前 → 今の名前。split の頭に当たれば（長い方が先）それで、無ければ枚の番号の写し方（RN）で。戻り値 [名前, split に当たったか]
SDY.renameOld = function (id, RN, SP) {
    var best = "", k;
    if (SP) { for (k in SP) { if (SP.hasOwnProperty(k) && id.indexOf(k) === 0 && k.length > best.length) { best = k; } } }
    if (best) { return [SP[best] + id.substring(best.length), true]; }
    var m = /^p(\d+)\./.exec(id);
    return [(RN && m && RN[m[1]]) ? "p" + RN[m[1]] + id.substring(m[0].length - 1) : id, false];
};
SDY.abMap = null;                                    // 前の .ai のアートボード番号（0から）→ 新しい .ai のアートボード番号
SDY.placeLink = function (doc, lay, i, p) {
    var f = File(SDY.root.fsName + "/" + p.file);
    if (!f.exists) { SDY.missing.push(p.file); return null; }
    app.preferences.PDFFileOptions.pageToOpen = p.page || 1;
    try { app.preferences.PDFFileOptions.pDFCropToBox = PDFBoxType.PDFMEDIABOX; } catch (e) {}
    var it = lay.placedItems.add();
    it.file = f;
    var tl = SDY.P(doc, i, p.x, p.y), s = p.scale || 1, K = SDY.K;
    if (!p.clip && p.clipgroup) {                    // 大きく描いた配置図を一つの切り抜きのグループに（四角を動かして使う大きさを選ぶ、ユーザー 10-26夕）
        it.width = p.w * K; it.height = p.h * K;
        it.position = tl;
        SDY.tag(it, p);
        var cg = null, q;
        for (q = 0; q < lay.groupItems.length; q++) { if (lay.groupItems[q].name === p.clipgroup) { cg = lay.groupItems[q]; break; } }
        if (!cg) {
            cg = lay.groupItems.add(); cg.name = p.clipgroup;
            it.move(cg, ElementPlacement.PLACEATBEGINNING);
            var ct = SDY.P(doc, i, p.cliprect[0], p.cliprect[1]);
            var cr = cg.pathItems.rectangle(ct[1], ct[0], p.cliprect[2] * K, p.cliprect[3] * K);
            cr.filled = false; cr.stroked = false; cr.name = "切り抜きの四角（これを動かす・大きさを変える）";
            cr.move(cg, ElementPlacement.PLACEATBEGINNING);
            cg.clipped = true;
        } else {
            it.move(cg.pageItems[0], ElementPlacement.PLACEAFTER);   // 四角のすぐ下＝前に入れた物の上
        }
        return it;
    }
    if (!p.clip) {
        it.width = p.w * K; it.height = p.h * K;
        it.position = tl;
        SDY.tag(it, p);
        return it;
    }
    it.width = it.width * s; it.height = it.height * s;                 // 元のPDFの全体を倍率どおりに
    it.position = [tl[0] - p.clip[0] * K * s, tl[1] + p.clip[1] * K * s];
    var g = lay.groupItems.add();
    it.move(g, ElementPlacement.PLACEATEND);
    if (p.overlay) {                                 // Rhino の線（下）と文字と寸法（上）：同じ紙・同じ位置の二つのリンク（10-28）
        it.name = p.base_name || "線（Rhino）";
        SDY.addOverlay(g, it, p);
    }
    var r = g.pathItems.rectangle(tl[1], tl[0], p.w * K, p.h * K);     // いちばん上の四角が切り抜きの形
    r.filled = false; r.stroked = false;
    g.clipped = true;
    SDY.tag(g, p);
    return g;
};
// 切り抜きのグループの中のリンク：重ねる図（文字と寸法）を、下の図（線）と同じ大きさ・同じ位置に。build と update_texts が使う
SDY.overlayIn = function (g, p) {
    var k;
    for (k = 0; k < g.placedItems.length; k++) { if (g.placedItems[k].name === (p.overlay_name || "文字と寸法")) { return g.placedItems[k]; } }
    return null;
};
SDY.baseIn = function (g, p) {
    var k, ov = p ? (p.overlay_name || "文字と寸法") : "文字と寸法";
    for (k = 0; k < g.placedItems.length; k++) { if (g.placedItems[k].name !== ov) { return g.placedItems[k]; } }
    return null;
};
SDY.addOverlay = function (g, base, p) {
    var f = File(SDY.root.fsName + "/" + p.overlay);
    if (!f.exists) { SDY.missing.push(p.overlay); return null; }
    app.preferences.PDFFileOptions.pageToOpen = p.page || 1;
    var ov = g.placedItems.add();
    ov.file = f;
    ov.width = base.width; ov.height = base.height; ov.position = base.position;
    ov.name = p.overlay_name || "文字と寸法";
    ov.move(base, ElementPlacement.PLACEBEFORE);    // 線の上
    return ov;
};
// 部品をまとめるグループ（p.group）。同じ名前のグループがレイヤーにあればそこへ、無ければ作る（注の文字と線、突き出た木の枝と幹）。
// 図面の部品（p.dwg、10-29）は、グループのメモの印（sdyg:鍵）で探す（寸法は同じ名前が多いので名前では探さない。図面のまとめの中にあっても見つける）
SDY.dwgCont = null;
SDY.cont = function (lay, p) {
    if (!p.group) { return null; }
    var nm = p.group_name || p.group, k;
    if (p.dwg) {
        if (!SDY.dwgCont) {
            SDY.dwgCont = {};
            var gs = app.activeDocument.groupItems, nt;
            for (k = 0; k < gs.length; k++) { nt = ""; try { nt = gs[k].note; } catch (e0) {} if (nt && nt.indexOf("sdyg:") === 0) { SDY.dwgCont[nt.substring(5)] = gs[k]; } }
        }
        if (SDY.dwgCont[p.group]) { return SDY.dwgCont[p.group]; }
        var dg = lay.groupItems.add(); dg.name = nm; dg.note = "sdyg:" + p.group;
        SDY.dwgCont[p.group] = dg;
        return dg;
    }
    for (k = 0; k < lay.groupItems.length; k++) { if (lay.groupItems[k].name === nm) { return lay.groupItems[k]; } }
    var ex = SDY.findGroupTop(app.activeDocument, nm, null);   // 別のレイヤーにある同じグループ（部品のレイヤーが違っても割らない。レイヤーは後で重ね順の記録が決める、10-30）
    if (ex) { return ex; }
    var g = lay.groupItems.add(); g.name = nm;
    return g;
};
SDY.intoCont = function (lay, p, it) { var g = SDY.cont(lay, p); if (g && it) { it.move(g, ElementPlacement.PLACEATBEGINNING); } return it; };
SDY.makeCircle = function (doc, lay, i, p) {
    var tl = SDY.P(doc, i, p.x, p.y), K = SDY.K;
    var e = lay.pathItems.ellipse(tl[1], tl[0], p.w * K, p.h * K);
    e.filled = !!p.fill; if (p.fill) { e.fillColor = SDY.rgb(p.fill); }
    e.stroked = !!p.stroke; if (p.stroke) { e.strokeColor = SDY.rgb(p.stroke); e.strokeWidth = p.lw || 0.3; }
    if (p.alpha !== undefined && p.alpha < 1) { e.opacity = p.alpha * 100; }
    SDY.tag(e, p);
    return SDY.intoCont(lay, p, e);
};
SDY.makeText = function (doc, lay, i, p) {
    var tf;
    if (p.kind === "area") {
        var tl = SDY.P(doc, i, p.x, p.y);
        var r = lay.pathItems.rectangle(tl[1], tl[0], p.w * SDY.K, p.h * SDY.K);
        tf = lay.textFrames.areaText(r);
    } else {
        tf = lay.textFrames.pointText(SDY.P(doc, i, p.x, p.y));
    }
    tf.contents = String(p.s).replace(/\n/g, "\r");
    SDY.styleText(tf, p);
    if (p.ustyle) { SDY.applyRuns(tf, p.ustyle, p.id); }
    if (p.stale_user_s) { SDY.missing.push("書き換えた文の元が変わった：" + p.id + "（新しい文にした。.ai で見直す）"); }
    if (p.rot) {                                     // 向きのある字（縦の寸法・斜めの寸法、10-29）：基準線の点（揃えの点）を中心に回す
        var a0 = tf.anchor;
        tf.rotate(Number(p.rot));
        var a1 = tf.anchor;
        tf.translate(a0[0] - a1[0], a0[1] - a1[1]);
    }
    SDY.tag(tf, p);
    return SDY.intoCont(lay, p, tf);
};
// 図面の線の部品（寸法線と端の印、高さの記号、通り芯の丸、字の白い地など、10-29）：いくつかのパスを一つのグループに。もとの重なりの順（後のものが上）
SDY.makeLines = function (doc, lay, i, p) {
    var g = lay.groupItems.add(), k, j, q, pts, pi, r, cp;
    for (k = 0; k < p.paths.length; k++) {
        q = p.paths[k]; pts = [];
        if (q.rings) {                                 // 穴のある形（ゾーニングの区分、10-31）：複合パス。塗りは穴を抜く
            cp = g.compoundPathItems.add();
            for (r = 0; r < q.rings.length; r++) {
                pts = [];
                for (j = 0; j < q.rings[r].length; j++) { pts.push(SDY.P(doc, i, q.rings[r][j][0], q.rings[r][j][1])); }
                pi = cp.pathItems.add(); pi.setEntirePath(pts); pi.closed = true;
                if (q.fill) { pi.filled = true; pi.fillColor = q.swatch ? SDY.swatchColor(q.swatch, q.fill) : SDY.rgb(q.fill); } else { pi.filled = false; }
                if (q.stroke && q.lw > 0) { pi.stroked = true; pi.strokeColor = SDY.rgb(q.stroke); pi.strokeWidth = q.lw; } else { pi.stroked = false; }
                try { pi.evenodd = true; } catch (e3) {}
            }
            if (q.name) { cp.name = q.name; }
            continue;
        }
        for (j = 0; j < q.pts.length; j++) { pts.push(SDY.P(doc, i, q.pts[j][0], q.pts[j][1])); }
        pi = g.pathItems.add();
        pi.setEntirePath(pts);
        if (q.name) { pi.name = q.name; }
        pi.closed = !!q.closed;
        if (q.fill) { pi.filled = true; pi.fillColor = q.swatch ? SDY.swatchColor(q.swatch, q.fill) : SDY.rgb(q.fill); } else { pi.filled = false; }
        if (q.stroke && q.lw > 0) {
            pi.stroked = true; pi.strokeColor = SDY.rgb(q.stroke); pi.strokeWidth = q.lw;
            try { pi.strokeCap = StrokeCap.BUTTENDCAP; } catch (e1) {}
            if (q.dash) { pi.strokeDashes = q.dash; }
        } else { pi.stroked = false; }
        if (q.eo) { try { pi.evenodd = true; } catch (e2) {} }
        if (q.op !== undefined && q.op !== null && q.op < 1) { pi.opacity = q.op * 100; }
    }
    SDY.tag(g, p);
    return SDY.intoCont(lay, p, g);
};
SDY.makeBox = function (doc, lay, i, p) {
    var tl = SDY.P(doc, i, p.x, p.y);
    var r = lay.pathItems.rectangle(tl[1], tl[0], p.w * SDY.K, p.h * SDY.K);
    r.filled = !!p.fill; if (p.fill) { r.fillColor = p.swatch ? SDY.swatchColor(p.swatch, p.fill) : SDY.rgb(p.fill); }
    r.stroked = !!p.stroke; if (p.stroke) { r.strokeColor = SDY.rgb(p.stroke); r.strokeWidth = p.lw || 0.5; }
    if (p.dash) { r.strokeDashes = [p.dash[0] * (p.lw || 0.5), p.dash[1] * (p.lw || 0.5)]; }
    SDY.tag(r, p);
    return SDY.intoCont(lay, p, r);                  // 印の□は数字と一つのグループに（10-28）
};
SDY.makeLine = function (doc, lay, i, p) {
    var g = lay.groupItems.add(), pts = [], k, K = SDY.K;
    for (k = 0; k < p.pts.length; k++) { pts.push(SDY.P(doc, i, p.pts[k][0], p.pts[k][1])); }
    var pi = g.pathItems.add();
    pi.setEntirePath(pts);
    pi.filled = false; pi.stroked = true; pi.strokeColor = SDY.rgb(p.color); pi.strokeWidth = p.lw || 0.6;
    if (p.arrow) {                                         // 終わりの点に矢じり（長さ p.arrow mm）
        var b = pts[pts.length - 1], a = pts[pts.length - 2], ux = b[0] - a[0], uy = b[1] - a[1], ul = Math.sqrt(ux * ux + uy * uy), L = p.arrow * K;
        ux /= ul; uy /= ul;
        var tri = g.pathItems.add();
        tri.setEntirePath([b, [b[0] - ux * L - uy * L * 0.35, b[1] - uy * L + ux * L * 0.35], [b[0] - ux * L + uy * L * 0.35, b[1] - uy * L - ux * L * 0.35]]);
        tri.closed = true; tri.stroked = false; tri.filled = true; tri.fillColor = SDY.rgb(p.color);
        pi.setEntirePath(pts.slice(0, pts.length - 1).concat([[b[0] - ux * L * 0.8, b[1] - uy * L * 0.8]]));   // 線は矢じりの中で止める
    }
    if (p.dot) {
        var e = pts[pts.length - 1], rr = p.dot * K;
        var d = g.pathItems.ellipse(e[1] + rr, e[0] - rr, 2 * rr, 2 * rr);
        d.stroked = false; d.filled = true; d.fillColor = SDY.rgb(p.color);
    }
    SDY.tag(g, p);
    return SDY.intoCont(lay, p, g);
};
SDY.layerOf = function (doc, p) { return SDY.layer(doc, p.layer || "説明"); };
SDY.make = function (doc, i, p) {
    var lay = SDY.layerOf(doc, p);
    if (p.kind === "link") { var lk = SDY.placeLink(doc, lay, i, p); return (p.group && !p.clipgroup) ? SDY.intoCont(lay, p, lk) : lk; }   // グループに入れるリンク（用水のネットワーク、10-29）
    if (p.kind === "text" || p.kind === "area") { return SDY.makeText(doc, lay, i, p); }
    if (p.kind === "box") { return SDY.makeBox(doc, lay, i, p); }
    if (p.kind === "line") { return SDY.makeLine(doc, lay, i, p); }
    if (p.kind === "lines") { return SDY.makeLines(doc, lay, i, p); }
    if (p.kind === "circle") { return SDY.makeCircle(doc, lay, i, p); }
    return null;
};
// 枠：外枠・上の帯の線・表題・右下の名前を一つのシンボル「枠」に（全ページ共通）
SDY.makeFrame = function (doc, L) {
    var F = L.frame, K = SDY.K, W = L.artboard[0], H = L.artboard[1], lay = SDY.layer(doc, "枠"), i;
    var g = lay.groupItems.add();
    var o = SDY.P(doc, 0, F.margin, F.margin);
    var r = g.pathItems.rectangle(o[1], o[0], (W - 2 * F.margin) * K, (H - 2 * F.margin) * K);
    r.filled = false; r.stroked = true; r.strokeWidth = F.lw_rect; r.strokeColor = SDY.rgb(F.color);
    var ln = g.pathItems.add();
    ln.setEntirePath([SDY.P(doc, 0, F.margin, F.margin + F.header), SDY.P(doc, 0, W - F.margin, F.margin + F.header)]);
    ln.filled = false; ln.stroked = true; ln.strokeWidth = F.lw_header; ln.strokeColor = SDY.rgb(F.color);
    var t1 = lay.textFrames.pointText(SDY.P(doc, 0, F.title.x, F.title.y));       // 文字はレイヤーに作って体裁を掛けてからグループへ（9503よけ）
    t1.contents = F.title.s; SDY.styleText(t1, { size_pt: F.title.size_pt, font: F.title.font, color: F.color, align: "left" });
    t1.move(g, ElementPlacement.PLACEATEND);
    var t2 = lay.textFrames.pointText(SDY.P(doc, 0, F.footer.x, F.footer.y));
    t2.contents = F.footer.s; SDY.styleText(t2, { size_pt: F.footer.size_pt, font: F.footer.font, color: F.color, align: "right" });
    t2.move(g, ElementPlacement.PLACEATEND);
    var gb = g.geometricBounds, a0 = SDY.ab(doc, 0), dx = gb[0] - a0[0], dy = gb[1] - a0[1];
    var sym = doc.symbols.add(g);
    sym.name = "枠";
    for (i = 0; i < L.pages.length; i++) {
        if (!L.pages[i].frame) { continue; }
        var si = lay.symbolItems.add(sym), sb = si.geometricBounds, ai = SDY.ab(doc, i);
        si.translate(ai[0] + dx - sb[0], ai[1] + dy - sb[1]);
        si.name = "枠";
        if (L.pages[i].frame === "top") { si.move(SDY.layer(doc, "線"), ElementPlacement.PLACEATBEGINNING); }   // 紙いっぱいの図（4枚目の平面図）の上に（10-29）
    }
    g.remove();
};
SDY.findByTag = function (doc) {                    // id → 物
    var map = {}, i, it, t;
    for (i = 0; i < doc.pageItems.length; i++) {
        it = doc.pageItems[i];
        t = SDY.parseTag(it);
        if (t) { map[t.id] = it; }
    }
    return map;
};

// 箱と文字をひとまとめに（ユーザー 10-25：箱を動かせば文字も動く）。箱・見出し・本文を、箱の名前のグループに入れる
SDY.groupBoxes = function (doc, only) {              // only：新しく描いた部品の id（前からある箱は、木田さんがグループを解いていてもそのまま、10-31）
    var map = SDY.findByTag(doc), id, it, t, n = 0, g, h, b;
    for (id in map) {
        if (!map.hasOwnProperty(id)) { continue; }
        if (only && !only[id]) { continue; }
        it = map[id]; t = SDY.parseTag(it);
        if (!t || t.kind !== "box") { continue; }
        if (it.parent.typename === "GroupItem") { continue; }   // もうまとめてある・印の□（数字とのグループ、10-28）
        g = it.layer.groupItems.add(); g.name = it.name;
        g.move(it, ElementPlacement.PLACEBEFORE);
        it.move(g, ElementPlacement.PLACEATEND);
        h = map[id + ".head"]; b = map[id + ".body"];
        if (h) { h.move(g, ElementPlacement.PLACEATBEGINNING); }
        if (b) { b.move(g, ElementPlacement.PLACEATBEGINNING); }
        n++;
    }
    return n;
};
// 引き出し線を箱に付け直す（箱を動かした後に）。線の終わり（点）は動かさず、始まりを箱の縁の、点に近い側へ
SDY.leaderBoxMap = function (L) {                   // layout.json から 線のid → 箱のid（線の始まりが箱の縁にあるもの）
    var m = {}, i, j, k, p, q, s0, ok;
    for (i = 0; i < L.pages.length; i++) {
        for (j = 0; j < L.pages[i].parts.length; j++) {
            p = L.pages[i].parts[j];
            if (p.kind !== "line" || !p.pts || p.pts.length < 2) { continue; }
            s0 = p.pts[0];
            for (k = 0; k < L.pages[i].parts.length; k++) {
                q = L.pages[i].parts[k];
                if (q.kind !== "box") { continue; }
                ok = s0[0] >= q.x - 1.5 && s0[0] <= q.x + q.w + 1.5 && s0[1] >= q.y - 1.5 && s0[1] <= q.y + q.h + 1.5;
                if (ok) { m[p.id] = q.id; break; }
            }
        }
    }
    return m;
};
SDY.reconnect = function (doc, L) {
    var map = SDY.findByTag(doc), lb = SDY.leaderBoxMap(L), id, ln, bx, k, path, dot, tgt, gb, sx, sy, K = SDY.K, n = 0, pp;
    for (id in lb) {
        if (!lb.hasOwnProperty(id)) { continue; }
        ln = map[id]; bx = map[lb[id]];
        if (!ln || !bx || ln.typename !== "GroupItem") { continue; }
        path = null; dot = null;
        for (k = 0; k < ln.pathItems.length; k++) { if (ln.pathItems[k].closed) { dot = ln.pathItems[k]; } else { path = ln.pathItems[k]; } }
        if (!path) { continue; }
        if (dot) { gb = dot.geometricBounds; tgt = [(gb[0] + gb[2]) / 2, (gb[1] + gb[3]) / 2]; }
        else { pp = path.pathPoints; tgt = pp[pp.length - 1].anchor; }
        gb = bx.geometricBounds;                        // [左, 上, 右, 下]（上の方が大きい）
        if (tgt[0] >= gb[2]) { sx = gb[2]; } else if (tgt[0] <= gb[0]) { sx = gb[0]; }
        else { sx = (Math.abs(tgt[0] - gb[0]) < Math.abs(tgt[0] - gb[2])) ? gb[0] : gb[2]; }
        sy = Math.max(gb[3] + 3 * K, Math.min(gb[1] - 3 * K, tgt[1]));
        path.setEntirePath([[sx, sy], [tgt[0], tgt[1]]]);
        n++;
    }
    return n;
};

// 木田さんが足した物（部品の印 sdy: の無い物）：書き出して台帳に残し、組み直しのときは前の .ai から写す（ユーザー、10-26）
SDY.hasTag = function (it) {
    if (SDY.parseTag(it)) { return true; }
    if (it.typename === "GroupItem") {
        var k;
        for (k = 0; k < it.pageItems.length; k++) { if (SDY.hasTag(it.pageItems[k])) { return true; } }
    }
    return false;
};
SDY.isOurs = function (it) {
    if (it.typename === "SymbolItem" && it.name === "枠") { return true; }
    return SDY.hasTag(it);
};
SDY.userItems = function (doc) {                     // レイヤーのいちばん上の階の物のうち、印の無いもの
    var out = [], i, k, L, it;
    for (i = 0; i < doc.layers.length; i++) {
        L = doc.layers[i];
        if (L.name === SDY.OUT_LAYER) { continue; }   // 外した物（10-31）は木田さんの物の台帳に入れない（組み替えはレイヤーごと持ってくる）
        for (k = 0; k < L.pageItems.length; k++) {
            it = L.pageItems[k];
            try { if (it.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
            if (!SDY.isOurs(it)) { out.push(it); }
            else if (it.typename === "GroupItem" && !SDY.parseTag(it)) { SDY.userInGroup(it, out); }   // 部品のグループ（配置図の切り抜きなど）に入れた木田さんの物も（10-28：風の線が消えた）
        }
    }
    return out;
};
SDY.userInGroup = function (g, out) {               // 印の無いグループの中の、印の無い物（切り抜きの四角は除く）
    var k, c, clip;
    for (k = 0; k < g.pageItems.length; k++) {
        c = g.pageItems[k];
        if (SDY.parseTag(c)) { continue; }
        clip = false; try { clip = c.clipping; } catch (e) {}
        if (clip) { continue; }
        if (c.typename === "GroupItem" && SDY.hasTag(c)) { SDY.userInGroup(c, out); } else { out.push(c); }
    }
};
// 線の部品（グループ）の塗り：最初の塗りのあるパスの色（ゾーニングの区分に木田さんが付けた塗り、10-31）。無ければ null
SDY.fillOf = function (it) {
    var k, c, f = null;
    try {
        if (it.typename === "PathItem") { return it.filled ? SDY.hexOf(it.fillColor) : null; }
        if (it.typename === "CompoundPathItem") { return it.pathItems.length ? SDY.fillOf(it.pathItems[0]) : null; }
        if (it.typename === "GroupItem") { for (k = 0; k < it.pageItems.length && !f; k++) { f = SDY.fillOf(it.pageItems[k]); } }
    } catch (e) {}
    return f;
};
SDY.setFill = function (it, hex) {
    var k;
    try {
        if (it.typename === "PathItem") { it.filled = true; it.fillColor = SDY.rgb(hex); return; }
        if (it.typename === "CompoundPathItem" || it.typename === "GroupItem") { for (k = 0; k < it.pageItems.length; k++) { SDY.setFill(it.pageItems[k], hex); } }
        if (it.typename === "CompoundPathItem") { for (k = 0; k < it.pathItems.length; k++) { SDY.setFill(it.pathItems[k], hex); } }
    } catch (e) {}
};
SDY.hexOf = function (c) {
    try {
        if (c.typename === "RGBColor") {
            var h = function (v) { var t = Math.round(v).toString(16); return t.length < 2 ? "0" + t : t; };
            return "#" + h(c.red) + h(c.green) + h(c.blue);
        }
        if (c.typename === "GrayColor") { return "gray" + Math.round(c.gray); }
        if (c.typename === "NoColor") { return null; }
        return c.typename;
    } catch (e) { return null; }
};
SDY.describe = function (doc, it) {                   // 台帳に残す中身（mm、アートボードの左上から）
    var b = it.geometricBounds, ai = SDY.abOf(doc, b), r = SDY.ab(doc, ai < 0 ? 0 : ai), K = SDY.K, d, k, pp;
    var mm = function (p) { return [Math.round((p[0] - r[0]) / K * 100) / 100, Math.round((r[1] - p[1]) / K * 100) / 100]; };
    d = { type: it.typename, name: it.name || "", layer: it.layer.name, artboard: ai + 1,
          x: mm([b[0], b[1]])[0], y: mm([b[0], b[1]])[1], w: Math.round((b[2] - b[0]) / K * 100) / 100, h: Math.round((b[1] - b[3]) / K * 100) / 100 };
    try { d.opacity = it.opacity; } catch (e) {}
    if (it.typename === "PathItem") {
        d.closed = it.closed;
        d.fill = it.filled ? SDY.hexOf(it.fillColor) : null;
        d.stroke = it.stroked ? SDY.hexOf(it.strokeColor) : null;
        if (it.stroked) { d.stroke_pt = it.strokeWidth; }
        d.pts = [];
        for (k = 0; k < it.pathPoints.length; k++) {
            pp = it.pathPoints[k];
            d.pts.push([mm(pp.anchor), mm(pp.leftDirection), mm(pp.rightDirection)]);
        }
    } else if (it.typename === "TextFrame") {
        d.s = SDY.norm(it.contents);
        try {                                         // 段落の枠（エリア内文字）は枠の大きさも（ユーザー 10-30：幅を狭くしても build で戻った）
            if (it.kind === TextType.AREATEXT) {
                var tb = it.textPath.geometricBounds, tp = mm([tb[0], tb[1]]);
                d.area = true; d.x = tp[0]; d.y = tp[1];
                d.w = Math.round((tb[2] - tb[0]) / K * 100) / 100; d.h = Math.round((tb[1] - tb[3]) / K * 100) / 100;
            }
        } catch (e9) {}
        try { d.size_pt = it.textRange.characterAttributes.size; } catch (e) {}
        try { d.color = SDY.hexOf(it.textRange.characterAttributes.fillColor); } catch (e) {}
        try { d.font = SDY.fontName(it.textRange.characterAttributes.textFont); } catch (e) {}
        try { var rs_ = SDY.runsOf(it); if (rs_.length > 1) { d.runs = rs_; } } catch (e) {}
    } else if (it.typename === "GroupItem" || it.typename === "CompoundPathItem") {
        d.children = [];
        var ch = it.typename === "GroupItem" ? it.pageItems : it.pathItems;
        for (k = 0; k < ch.length && k < 50; k++) { try { d.children.push(SDY.describe(doc, ch[k])); } catch (e) {} }
    } else if (it.typename === "PlacedItem" || it.typename === "RasterItem") {
        try { d.file = it.file.fsName; } catch (e) {}
    }
    return d;
};
SDY.copyUserItems = function (src, dst, known) {      // 前の .ai の木田さんの物を、新しい .ai の同じレイヤー・同じアートボードの同じ位置へ
    // known：layout_user.json にある鍵（user_items と deleted_user）。それらは json から描く・消したので写さない。写すのはまだ書き出していない物だけ（補助、10-29）
    var items = SDY.userItems(src), n = 0, i, it, ai, ra, rb, dup, lay, uk;
    for (i = items.length - 1; i >= 0; i--) {
        it = items[i];
        uk = SDY.userKey(it);
        if (uk && known && known[uk]) { continue; }
        try {
            ai = SDY.abOf(src, it.geometricBounds);
            lay = SDY.userLayer(dst, it.layer.name);
            dup = it.duplicate(lay, ElementPlacement.PLACEATBEGINNING);
            if (ai >= 0 && ai < dst.artboards.length) {
                var bi = SDY.abMap ? SDY.abMap(ai) : ai;      // 番号を振り直したときは新しい番号のアートボードへ
                ra = src.artboards[ai].artboardRect; rb = dst.artboards[bi].artboardRect;
                dup.translate(rb[0] - ra[0], rb[1] - ra[1]);
                var sp = SDY.planShift, gb = it.geometricBounds;
                if (sp && bi === sp.ab) {                  // 配置図の上に描いた物は、配置図が紙の上で動いた分だけ一緒に動かし、配置図のまとめに入れる（10-28）
                    var cx = ((gb[0] + gb[2]) / 2 - ra[0]) / SDY.K, cy = (ra[1] - (gb[1] + gb[3]) / 2) / SDY.K, w = sp.win;
                    if (cx >= w[0] && cx <= w[0] + w[2] && cy >= w[1] && cy <= w[1] + w[3]) {
                        if (Math.abs(sp.dx) > 0.05 || Math.abs(sp.dy) > 0.05) { dup.translate(sp.dx * SDY.K, -sp.dy * SDY.K); }
                        sp.n++; SDY.planUser.push(dup);
                    }
