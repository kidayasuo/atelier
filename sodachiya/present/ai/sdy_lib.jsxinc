// 育ち舎のプレゼン：Illustratorの割付スクリプトの共通部分（build / export / update が #include する）
// ExtendScript（ES3）で書く：let・const・アロー関数・JSONオブジェクトは使わない。
var SDY = {};
SDY.K = 72 / 25.4;                                   // mm → pt
SDY.here = File($.fileName).parent;                  // present/ai
SDY.root = SDY.here.parent.parent;                   // sodachiya

SDY.readText = function (f) {
    f.encoding = "UTF-8";
    if (!f.open("r")) { throw new Error("開けない: " + f.fsName); }
    var t = f.read(); f.close();
    if (t.charCodeAt(0) === 0xFEFF) { t = t.substring(1); }
    return t;
};
SDY.readJSON = function (f) { return eval("(" + SDY.readText(f) + ")"); };   // 自分たちのファイルだけを読む
SDY.writeText = function (f, t) {
    f.encoding = "UTF-8"; f.lineFeed = "Unix";
    if (!f.open("w")) { throw new Error("書けない: " + f.fsName); }
    f.write(t); f.close();
};
SDY.q = function (s) {
    var o = '"', i, c, h;
    for (i = 0; i < s.length; i++) {
        c = s.charAt(i); h = s.charCodeAt(i);
        if (c === '"') { o += '\\"'; } else if (c === "\\") { o += "\\\\"; }
        else if (c === "\n") { o += "\\n"; } else if (c === "\r") { o += "\\n"; } else if (c === "\t") { o += "\\t"; }
        else if (h < 32 || h === 0x2028 || h === 0x2029) { o += "\\u" + ("0000" + h.toString(16)).slice(-4); }
        else { o += c; }
    }
    return o + '"';
};
SDY.stringify = function (v, ind) {
    ind = ind || "";
    var t = typeof v, out, k, i, a;
    if (v === null || v === undefined) { return "null"; }
    if (t === "number") { return isFinite(v) ? String(Math.round(v * 100) / 100) : "null"; }
    if (t === "boolean") { return v ? "true" : "false"; }
    if (t === "string") { return SDY.q(v); }
    if (v instanceof Array) {
        a = [];
        for (i = 0; i < v.length; i++) { a.push(SDY.stringify(v[i], ind + " ")); }
        return "[" + a.join(", ") + "]";
    }
    a = [];
    for (k in v) { if (v.hasOwnProperty(k)) { a.push(ind + " " + SDY.q(k) + ": " + SDY.stringify(v[k], ind + " ")); } }
    return "{\n" + a.join(",\n") + "\n" + ind + "}";
};
// 文字の印（mock.py の ai_layout.djb2 と同じ）：書き換えたかどうかを見るため
SDY.norm = function (s) { s = String(s).replace(/\r\n?/g, "\n").replace(/\u0003/g, "\n"); return s.replace(/\n+$/, ""); };
SDY.hash = function (s) {
    s = SDY.norm(s);
    var h = 5381, i;
    for (i = 0; i < s.length; i++) { h = (h * 33 + s.charCodeAt(i)) % 4294967296; }
    return h.toString(16);
};
SDY.rgb = function (hex) {
    var c = new RGBColor();
    hex = String(hex || "#222222").replace("#", "");
    c.red = parseInt(hex.substr(0, 2), 16); c.green = parseInt(hex.substr(2, 2), 16); c.blue = parseInt(hex.substr(4, 2), 16);
    return c;
};
SDY.fontCache = {};
SDY.font = function (w) {
    if (SDY.fontCache[w] !== undefined) { return SDY.fontCache[w]; }
    var names = (w === "W6") ? ["HiraginoSans-W6", "HiraKakuProN-W6", "HiraKakuPro-W6", "HiraginoSans-W5"]
                              : ["HiraginoSans-W3", "HiraKakuProN-W3", "HiraKakuPro-W3", "HiraginoSans-W2"];
    var i, f = null;
    for (i = 0; i < names.length && !f; i++) { try { f = app.textFonts.getByName(names[i]); } catch (e) { f = null; } }
    SDY.fontCache[w] = f;
    return f;
};
SDY.layer = function (doc, name) {
    try { return doc.layers.getByName(name); } catch (e) { var l = doc.layers.add(); l.name = name; return l; }
};
SDY.ab = function (doc, i) { return doc.artboards[i].artboardRect; };            // [左, 上, 右, 下]（pt、ドキュメント座標、yは上へ）
SDY.P = function (doc, i, x, y) { var r = SDY.ab(doc, i); return [r[0] + x * SDY.K, r[1] - y * SDY.K]; };
SDY.abOf = function (doc, b) {                                                     // 物の外形 b から、どのアートボードか
    if (!b || b.length < 4) { return -1; }
    var cx = (b[0] + b[2]) / 2, cy = (b[1] + b[3]) / 2, i, r;
    for (i = 0; i < doc.artboards.length; i++) {
        r = doc.artboards[i].artboardRect;
        if (cx >= r[0] && cx <= r[2] && cy <= r[1] && cy >= r[3]) { return i; }
    }
    return -1;
};
SDY.tag = function (it, p) {
    it.name = p.name || p.id;
    it.note = "sdy:" + p.kind + "|" + p.id + "|" + (p.mock_hash || "");
};
SDY.parseTag = function (it) {
    var n = "";
    try { n = it.note; } catch (e) { return null; }
    if (!n || n.indexOf("sdy:") !== 0) { return null; }
    var a = n.substring(4).split("|");
    return { kind: a[0], id: a[1], mock_hash: a[2] || "" };
};
// 文字の体裁。Illustratorは文字の範囲によって Error 9503（illegal text range）を出すことがあるので、
// 属性は一つずつ try で掛け、全体に掛けられなければ段落ごと・文字ごとに掛ける（10-25、ユーザーの試運転で9503）
SDY._each = function (tf, fn) {
    try { fn(tf.textRange); return; } catch (e0) {}
    var k, ok = false;
    try { for (k = 0; k < tf.paragraphs.length; k++) { try { if (tf.paragraphs[k].length > 0) { fn(tf.paragraphs[k]); ok = true; } } catch (e1) {} } } catch (e2) {}
    if (ok) { return; }
    try { for (k = 0; k < tf.characters.length; k++) { try { fn(tf.characters[k]); } catch (e3) {} } } catch (e4) {}
};
SDY.styleText = function (tf, p) {
    var f = SDY.font(p.font), size = Number(p.size_pt), lead = Number(p.leading || 1.5);
    if (!(size > 0.1 && size < 1296)) { size = 10; }
    var jus = (p.justify === "full_last_left") ? Justification.FULLJUSTIFYLASTLINELEFT :
              ((p.align === "center") ? Justification.CENTER : ((p.align === "right") ? Justification.RIGHT : Justification.LEFT));
    // 段落は両端揃え・最終行は左（ユーザー 10-25夕）、一字下げしない、段落のあいだは1行分、行送り＝文字の1.5倍
    SDY._each(tf, function (r) { r.characterAttributes.size = size; });
    if (f) { SDY._each(tf, function (r) { r.characterAttributes.textFont = f; }); }
    SDY._each(tf, function (r) { r.characterAttributes.fillColor = SDY.rgb(p.color); });
    SDY._each(tf, function (r) { r.characterAttributes.autoLeading = false; r.characterAttributes.leading = size * lead; });
    SDY._each(tf, function (r) { r.paragraphAttributes.justification = jus; });
    SDY._each(tf, function (r) { r.paragraphAttributes.firstLineIndent = 0; });
    if (p.para_space) { SDY._each(tf, function (r) { r.paragraphAttributes.spaceAfter = size * Number(p.para_space); }); }
};
SDY.missing = [];
SDY.placeLink = function (doc, lay, i, p) {
    var f = File(SDY.root.fsName + "/" + p.file);
    if (!f.exists) { SDY.missing.push(p.file); return null; }
    app.preferences.PDFFileOptions.pageToOpen = p.page || 1;
    try { app.preferences.PDFFileOptions.pDFCropToBox = PDFBoxType.PDFMEDIABOX; } catch (e) {}
    var it = lay.placedItems.add();
    it.file = f;
    var tl = SDY.P(doc, i, p.x, p.y), s = p.scale || 1, K = SDY.K;
    if (!p.clip && p.clipgroup) {                    // 大きく描いた配置図を一つの切り抜きのグループに（四角を動かして使う大きさを選ぶ、ユーザー 10-26夕）
        it.width = p.w * K; it.height = p.h * K;
        it.position = tl;
        SDY.tag(it, p);
        var cg = null, q;
        for (q = 0; q < lay.groupItems.length; q++) { if (lay.groupItems[q].name === p.clipgroup) { cg = lay.groupItems[q]; break; } }
        if (!cg) {
            cg = lay.groupItems.add(); cg.name = p.clipgroup;
            it.move(cg, ElementPlacement.PLACEATBEGINNING);
            var ct = SDY.P(doc, i, p.cliprect[0], p.cliprect[1]);
            var cr = cg.pathItems.rectangle(ct[1], ct[0], p.cliprect[2] * K, p.cliprect[3] * K);
            cr.filled = false; cr.stroked = false; cr.name = "切り抜きの四角（これを動かす・大きさを変える）";
            cr.move(cg, ElementPlacement.PLACEATBEGINNING);
            cg.clipped = true;
        } else {
            it.move(cg.pageItems[0], ElementPlacement.PLACEAFTER);   // 四角のすぐ下＝前に入れた物の上
        }
        return it;
    }
    if (!p.clip) {
        it.width = p.w * K; it.height = p.h * K;
        it.position = tl;
        SDY.tag(it, p);
        return it;
    }
    it.width = it.width * s; it.height = it.height * s;                 // 元のPDFの全体を倍率どおりに
    it.position = [tl[0] - p.clip[0] * K * s, tl[1] + p.clip[1] * K * s];
    var g = lay.groupItems.add();
    it.move(g, ElementPlacement.PLACEATEND);
    var r = g.pathItems.rectangle(tl[1], tl[0], p.w * K, p.h * K);     // いちばん上の四角が切り抜きの形
    r.filled = false; r.stroked = false;
    g.clipped = true;
    SDY.tag(g, p);
    return g;
};
// 部品をまとめるグループ（p.group）。同じ名前のグループがレイヤーにあればそこへ、無ければ作る（注の文字と線、突き出た木の枝と幹）
SDY.cont = function (lay, p) {
    if (!p.group) { return null; }
    var nm = p.group_name || p.group, k;
    for (k = 0; k < lay.groupItems.length; k++) { if (lay.groupItems[k].name === nm) { return lay.groupItems[k]; } }
    var g = lay.groupItems.add(); g.name = nm;
    return g;
};
SDY.intoCont = function (lay, p, it) { var g = SDY.cont(lay, p); if (g && it) { it.move(g, ElementPlacement.PLACEATBEGINNING); } return it; };
SDY.makeCircle = function (doc, lay, i, p) {
    var tl = SDY.P(doc, i, p.x, p.y), K = SDY.K;
    var e = lay.pathItems.ellipse(tl[1], tl[0], p.w * K, p.h * K);
    e.filled = !!p.fill; if (p.fill) { e.fillColor = SDY.rgb(p.fill); }
    e.stroked = !!p.stroke; if (p.stroke) { e.strokeColor = SDY.rgb(p.stroke); e.strokeWidth = p.lw || 0.3; }
    if (p.alpha !== undefined && p.alpha < 1) { e.opacity = p.alpha * 100; }
    SDY.tag(e, p);
    return SDY.intoCont(lay, p, e);
};
SDY.makeText = function (doc, lay, i, p) {
    var tf;
    if (p.kind === "area") {
        var tl = SDY.P(doc, i, p.x, p.y);
        var r = lay.pathItems.rectangle(tl[1], tl[0], p.w * SDY.K, p.h * SDY.K);
        tf = lay.textFrames.areaText(r);
    } else {
        tf = lay.textFrames.pointText(SDY.P(doc, i, p.x, p.y));
    }
    tf.contents = String(p.s).replace(/\n/g, "\r");
    SDY.styleText(tf, p);
    SDY.tag(tf, p);
    return SDY.intoCont(lay, p, tf);
};
SDY.makeBox = function (doc, lay, i, p) {
    var tl = SDY.P(doc, i, p.x, p.y);
    var r = lay.pathItems.rectangle(tl[1], tl[0], p.w * SDY.K, p.h * SDY.K);
    r.filled = !!p.fill; if (p.fill) { r.fillColor = SDY.rgb(p.fill); }
    r.stroked = !!p.stroke; if (p.stroke) { r.strokeColor = SDY.rgb(p.stroke); r.strokeWidth = p.lw || 0.5; }
    if (p.dash) { r.strokeDashes = [p.dash[0] * (p.lw || 0.5), p.dash[1] * (p.lw || 0.5)]; }
    SDY.tag(r, p);
    return r;
};
SDY.makeLine = function (doc, lay, i, p) {
    var g = lay.groupItems.add(), pts = [], k, K = SDY.K;
    for (k = 0; k < p.pts.length; k++) { pts.push(SDY.P(doc, i, p.pts[k][0], p.pts[k][1])); }
    var pi = g.pathItems.add();
    pi.setEntirePath(pts);
    pi.filled = false; pi.stroked = true; pi.strokeColor = SDY.rgb(p.color); pi.strokeWidth = p.lw || 0.6;
    if (p.dot) {
        var e = pts[pts.length - 1], rr = p.dot * K;
        var d = g.pathItems.ellipse(e[1] + rr, e[0] - rr, 2 * rr, 2 * rr);
        d.stroked = false; d.filled = true; d.fillColor = SDY.rgb(p.color);
    }
    SDY.tag(g, p);
    return SDY.intoCont(lay, p, g);
};
SDY.layerOf = function (doc, p) { return SDY.layer(doc, p.layer || "説明"); };
SDY.make = function (doc, i, p) {
    var lay = SDY.layerOf(doc, p);
    if (p.kind === "link") { return SDY.placeLink(doc, lay, i, p); }
    if (p.kind === "text" || p.kind === "area") { return SDY.makeText(doc, lay, i, p); }
    if (p.kind === "box") { return SDY.makeBox(doc, lay, i, p); }
    if (p.kind === "line") { return SDY.makeLine(doc, lay, i, p); }
    if (p.kind === "circle") { return SDY.makeCircle(doc, lay, i, p); }
    return null;
};
// 枠：外枠・上の帯の線・表題・右下の名前を一つのシンボル「枠」に（全ページ共通）
SDY.makeFrame = function (doc, L) {
    var F = L.frame, K = SDY.K, W = L.artboard[0], H = L.artboard[1], lay = SDY.layer(doc, "枠"), i;
    var g = lay.groupItems.add();
    var o = SDY.P(doc, 0, F.margin, F.margin);
    var r = g.pathItems.rectangle(o[1], o[0], (W - 2 * F.margin) * K, (H - 2 * F.margin) * K);
    r.filled = false; r.stroked = true; r.strokeWidth = F.lw_rect; r.strokeColor = SDY.rgb(F.color);
    var ln = g.pathItems.add();
    ln.setEntirePath([SDY.P(doc, 0, F.margin, F.margin + F.header), SDY.P(doc, 0, W - F.margin, F.margin + F.header)]);
    ln.filled = false; ln.stroked = true; ln.strokeWidth = F.lw_header; ln.strokeColor = SDY.rgb(F.color);
    var t1 = lay.textFrames.pointText(SDY.P(doc, 0, F.title.x, F.title.y));       // 文字はレイヤーに作って体裁を掛けてからグループへ（9503よけ）
    t1.contents = F.title.s; SDY.styleText(t1, { size_pt: F.title.size_pt, font: F.title.font, color: F.color, align: "left" });
    t1.move(g, ElementPlacement.PLACEATEND);
    var t2 = lay.textFrames.pointText(SDY.P(doc, 0, F.footer.x, F.footer.y));
    t2.contents = F.footer.s; SDY.styleText(t2, { size_pt: F.footer.size_pt, font: F.footer.font, color: F.color, align: "right" });
    t2.move(g, ElementPlacement.PLACEATEND);
    var gb = g.geometricBounds, a0 = SDY.ab(doc, 0), dx = gb[0] - a0[0], dy = gb[1] - a0[1];
    var sym = doc.symbols.add(g);
    sym.name = "枠";
    for (i = 0; i < L.pages.length; i++) {
        if (!L.pages[i].frame) { continue; }
        var si = lay.symbolItems.add(sym), sb = si.geometricBounds, ai = SDY.ab(doc, i);
        si.translate(ai[0] + dx - sb[0], ai[1] + dy - sb[1]);
        si.name = "枠";
    }
    g.remove();
};
SDY.findByTag = function (doc) {                    // id → 物
    var map = {}, i, it, t;
    for (i = 0; i < doc.pageItems.length; i++) {
        it = doc.pageItems[i];
        t = SDY.parseTag(it);
        if (t) { map[t.id] = it; }
    }
    return map;
};

// 箱と文字をひとまとめに（ユーザー 10-25：箱を動かせば文字も動く）。箱・見出し・本文を、箱の名前のグループに入れる
SDY.groupBoxes = function (doc) {
    var map = SDY.findByTag(doc), id, it, t, n = 0, g, h, b;
    for (id in map) {
        if (!map.hasOwnProperty(id)) { continue; }
        it = map[id]; t = SDY.parseTag(it);
        if (!t || t.kind !== "box") { continue; }
        if (it.parent.typename === "GroupItem" && it.parent.name === it.name) { continue; }   // もうまとめてある
        g = it.layer.groupItems.add(); g.name = it.name;
        g.move(it, ElementPlacement.PLACEBEFORE);
        it.move(g, ElementPlacement.PLACEATEND);
        h = map[id + ".head"]; b = map[id + ".body"];
        if (h) { h.move(g, ElementPlacement.PLACEATBEGINNING); }
        if (b) { b.move(g, ElementPlacement.PLACEATBEGINNING); }
        n++;
    }
    return n;
};
// 引き出し線を箱に付け直す（箱を動かした後に）。線の終わり（点）は動かさず、始まりを箱の縁の、点に近い側へ
SDY.leaderBoxMap = function (L) {                   // layout.json から 線のid → 箱のid（線の始まりが箱の縁にあるもの）
    var m = {}, i, j, k, p, q, s0, ok;
    for (i = 0; i < L.pages.length; i++) {
        for (j = 0; j < L.pages[i].parts.length; j++) {
            p = L.pages[i].parts[j];
            if (p.kind !== "line" || !p.pts || p.pts.length < 2) { continue; }
            s0 = p.pts[0];
            for (k = 0; k < L.pages[i].parts.length; k++) {
                q = L.pages[i].parts[k];
                if (q.kind !== "box") { continue; }
                ok = s0[0] >= q.x - 1.5 && s0[0] <= q.x + q.w + 1.5 && s0[1] >= q.y - 1.5 && s0[1] <= q.y + q.h + 1.5;
                if (ok) { m[p.id] = q.id; break; }
            }
        }
    }
    return m;
};
SDY.reconnect = function (doc, L) {
    var map = SDY.findByTag(doc), lb = SDY.leaderBoxMap(L), id, ln, bx, k, path, dot, tgt, gb, sx, sy, K = SDY.K, n = 0, pp;
    for (id in lb) {
        if (!lb.hasOwnProperty(id)) { continue; }
        ln = map[id]; bx = map[lb[id]];
        if (!ln || !bx || ln.typename !== "GroupItem") { continue; }
        path = null; dot = null;
        for (k = 0; k < ln.pathItems.length; k++) { if (ln.pathItems[k].closed) { dot = ln.pathItems[k]; } else { path = ln.pathItems[k]; } }
        if (!path) { continue; }
        if (dot) { gb = dot.geometricBounds; tgt = [(gb[0] + gb[2]) / 2, (gb[1] + gb[3]) / 2]; }
        else { pp = path.pathPoints; tgt = pp[pp.length - 1].anchor; }
        gb = bx.geometricBounds;                        // [左, 上, 右, 下]（上の方が大きい）
        if (tgt[0] >= gb[2]) { sx = gb[2]; } else if (tgt[0] <= gb[0]) { sx = gb[0]; }
        else { sx = (Math.abs(tgt[0] - gb[0]) < Math.abs(tgt[0] - gb[2])) ? gb[0] : gb[2]; }
        sy = Math.max(gb[3] + 3 * K, Math.min(gb[1] - 3 * K, tgt[1]));
        path.setEntirePath([[sx, sy], [tgt[0], tgt[1]]]);
        n++;
    }
    return n;
};

// 木田さんが足した物（部品の印 sdy: の無い物）：書き出して台帳に残し、組み直しのときは前の .ai から写す（ユーザー、10-26）
SDY.hasTag = function (it) {
    if (SDY.parseTag(it)) { return true; }
    if (it.typename === "GroupItem") {
        var k;
        for (k = 0; k < it.pageItems.length; k++) { if (SDY.hasTag(it.pageItems[k])) { return true; } }
    }
    return false;
};
SDY.isOurs = function (it) {
    if (it.typename === "SymbolItem" && it.name === "枠") { return true; }
    return SDY.hasTag(it);
};
SDY.userItems = function (doc) {                     // レイヤーのいちばん上の階の物のうち、印の無いもの
    var out = [], i, k, L, it;
    for (i = 0; i < doc.layers.length; i++) {
        L = doc.layers[i];
        for (k = 0; k < L.pageItems.length; k++) {
            it = L.pageItems[k];
            try { if (it.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
            if (!SDY.isOurs(it)) { out.push(it); }
        }
    }
    return out;
};
SDY.hexOf = function (c) {
    try {
        if (c.typename === "RGBColor") {
            var h = function (v) { var t = Math.round(v).toString(16); return t.length < 2 ? "0" + t : t; };
            return "#" + h(c.red) + h(c.green) + h(c.blue);
        }
        if (c.typename === "GrayColor") { return "gray" + Math.round(c.gray); }
        if (c.typename === "NoColor") { return null; }
        return c.typename;
    } catch (e) { return null; }
};
SDY.describe = function (doc, it) {                   // 台帳に残す中身（mm、アートボードの左上から）
    var b = it.geometricBounds, ai = SDY.abOf(doc, b), r = SDY.ab(doc, ai < 0 ? 0 : ai), K = SDY.K, d, k, pp;
    var mm = function (p) { return [Math.round((p[0] - r[0]) / K * 100) / 100, Math.round((r[1] - p[1]) / K * 100) / 100]; };
    d = { type: it.typename, name: it.name || "", layer: it.layer.name, artboard: ai + 1,
          x: mm([b[0], b[1]])[0], y: mm([b[0], b[1]])[1], w: Math.round((b[2] - b[0]) / K * 100) / 100, h: Math.round((b[1] - b[3]) / K * 100) / 100 };
    try { d.opacity = it.opacity; } catch (e) {}
    if (it.typename === "PathItem") {
        d.closed = it.closed;
        d.fill = it.filled ? SDY.hexOf(it.fillColor) : null;
        d.stroke = it.stroked ? SDY.hexOf(it.strokeColor) : null;
        if (it.stroked) { d.stroke_pt = it.strokeWidth; }
        d.pts = [];
        for (k = 0; k < it.pathPoints.length; k++) {
            pp = it.pathPoints[k];
            d.pts.push([mm(pp.anchor), mm(pp.leftDirection), mm(pp.rightDirection)]);
        }
    } else if (it.typename === "TextFrame") {
        d.s = SDY.norm(it.contents);
        try { d.size_pt = it.textRange.characterAttributes.size; } catch (e) {}
        try { d.color = SDY.hexOf(it.textRange.characterAttributes.fillColor); } catch (e) {}
    } else if (it.typename === "GroupItem" || it.typename === "CompoundPathItem") {
        d.children = [];
        var ch = it.typename === "GroupItem" ? it.pageItems : it.pathItems;
        for (k = 0; k < ch.length && k < 50; k++) { try { d.children.push(SDY.describe(doc, ch[k])); } catch (e) {} }
    } else if (it.typename === "PlacedItem" || it.typename === "RasterItem") {
        try { d.file = it.file.fsName; } catch (e) {}
    }
    return d;
};
SDY.copyUserItems = function (src, dst) {             // 前の .ai の木田さんの物を、新しい .ai の同じレイヤー・同じアートボードの同じ位置へ
    var items = SDY.userItems(src), n = 0, i, it, ai, ra, rb, dup, lay;
    for (i = items.length - 1; i >= 0; i--) {
        it = items[i];
        try {
            ai = SDY.abOf(src, it.geometricBounds);
            lay = SDY.layer(dst, it.layer.name);
            dup = it.duplicate(lay, ElementPlacement.PLACEATBEGINNING);
            if (ai >= 0 && ai < dst.artboards.length) {
                ra = src.artboards[ai].artboardRect; rb = dst.artboards[ai].artboardRect;
                dup.translate(rb[0] - ra[0], rb[1] - ra[1]);
                var sp = SDY.planShift, gb = it.geometricBounds;
                if (sp && ai === sp.ab) {                  // 配置図の上に描いた物は、配置図が紙の上で動いた分だけ一緒に動かす
                    var cx = ((gb[0] + gb[2]) / 2 - ra[0]) / SDY.K, cy = (ra[1] - (gb[1] + gb[3]) / 2) / SDY.K, w = sp.win;
                    if (cx >= w[0] && cx <= w[0] + w[2] && cy >= w[1] && cy <= w[1] + w[3]) { dup.translate(sp.dx * SDY.K, -sp.dy * SDY.K); sp.n++; }
                }
            }
            n++;
        } catch (e) { SDY.missing.push("木田さんの物（" + (it.name || it.typename) + "）を写せなかった：" + e.message); }
    }
    return n;
};
