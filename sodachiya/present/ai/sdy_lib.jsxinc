// 育ち舎のプレゼン：Illustratorの割付スクリプトの共通部分（build / export / update が #include する）
// ExtendScript（ES3）で書く：let・const・アロー関数・JSONオブジェクトは使わない。
var SDY = {};
SDY.K = 72 / 25.4;                                   // mm → pt
SDY.here = File($.fileName).parent;                  // present/ai
SDY.root = SDY.here.parent.parent;                   // sodachiya

SDY.readText = function (f) {
    f.encoding = "UTF-8";
    if (!f.open("r")) { throw new Error("開けない: " + f.fsName); }
    var t = f.read(); f.close();
    if (t.charCodeAt(0) === 0xFEFF) { t = t.substring(1); }
    return t;
};
SDY.readJSON = function (f) { return eval("(" + SDY.readText(f) + ")"); };   // 自分たちのファイルだけを読む
SDY.writeText = function (f, t) {
    f.encoding = "UTF-8"; f.lineFeed = "Unix";
    if (!f.open("w")) { throw new Error("書けない: " + f.fsName); }
    f.write(t); f.close();
};
SDY.q = function (s) {
    var o = '"', i, c, h;
    for (i = 0; i < s.length; i++) {
        c = s.charAt(i); h = s.charCodeAt(i);
        if (c === '"') { o += '\\"'; } else if (c === "\\") { o += "\\\\"; }
        else if (c === "\n") { o += "\\n"; } else if (c === "\r") { o += "\\n"; } else if (c === "\t") { o += "\\t"; }
        else if (h < 32 || h === 0x2028 || h === 0x2029) { o += "\\u" + ("0000" + h.toString(16)).slice(-4); }
        else { o += c; }
    }
    return o + '"';
};
SDY.stringify = function (v, ind) {
    ind = ind || "";
    var t = typeof v, out, k, i, a;
    if (v === null || v === undefined) { return "null"; }
    if (t === "number") { return isFinite(v) ? String(Math.round(v * 100) / 100) : "null"; }
    if (t === "boolean") { return v ? "true" : "false"; }
    if (t === "string") { return SDY.q(v); }
    if (v instanceof Array) {
        a = [];
        for (i = 0; i < v.length; i++) { a.push(SDY.stringify(v[i], ind + " ")); }
        return "[" + a.join(", ") + "]";
    }
    a = [];
    for (k in v) { if (v.hasOwnProperty(k)) { a.push(ind + " " + SDY.q(k) + ": " + SDY.stringify(v[k], ind + " ")); } }
    return "{\n" + a.join(",\n") + "\n" + ind + "}";
};
// 文字の印（mock.py の ai_layout.djb2 と同じ）：書き換えたかどうかを見るため
SDY.norm = function (s) { s = String(s).replace(/\r\n?/g, "\n").replace(/\u0003/g, "\n"); return s.replace(/\n+$/, ""); };
SDY.hash = function (s) {
    s = SDY.norm(s);
    var h = 5381, i;
    for (i = 0; i < s.length; i++) { h = (h * 33 + s.charCodeAt(i)) % 4294967296; }
    return h.toString(16);
};
SDY.rgb = function (hex) {
    var c = new RGBColor();
    hex = String(hex || "#222222").replace("#", "");
    c.red = parseInt(hex.substr(0, 2), 16); c.green = parseInt(hex.substr(2, 2), 16); c.blue = parseInt(hex.substr(4, 2), 16);
    return c;
};
SDY.fontCache = {};
SDY.font = function (w) {
    if (SDY.fontCache[w] !== undefined) { return SDY.fontCache[w]; }
    var names = (w === "W6") ? ["HiraginoSans-W6", "HiraKakuProN-W6", "HiraKakuPro-W6", "HiraginoSans-W5"]
              : (w === "W3" || !w) ? ["HiraginoSans-W3", "HiraKakuProN-W3", "HiraKakuPro-W3", "HiraginoSans-W2"]
              : [w, w.replace(/-/g, ""), "Apple Chancery", "HiraginoSans-W3"];          // 名前で（Apple-Chancery など、無ければヒラギノ）
    var i, f = null;
    for (i = 0; i < names.length && !f; i++) { try { f = app.textFonts.getByName(names[i]); } catch (e) { f = null; } }
    SDY.fontCache[w] = f;
    return f;
};
SDY.layer = function (doc, name) {
    try { return doc.layers.getByName(name); } catch (e) {
        var l = doc.layers.add(); l.name = name;
        // ゾーニングの白地図のレイヤー（10-31）：図より上、文字（説明）より下。後から作るときも「説明」のすぐ下へ（境界→上の線の順に作ると上の線が上）
        if (name.indexOf("ゾーニング") === 0) { try { l.move(doc.layers.getByName("説明"), ElementPlacement.PLACEAFTER); } catch (e2) {} }
        return l;
    }
};
SDY.ab = function (doc, i) { return doc.artboards[i].artboardRect; };            // [左, 上, 右, 下]（pt、ドキュメント座標、yは上へ）
SDY.P = function (doc, i, x, y) { var r = SDY.ab(doc, i); return [r[0] + x * SDY.K, r[1] - y * SDY.K]; };
SDY.abOf = function (doc, b) {                                                     // 物の外形 b から、どのアートボードか
    if (!b || b.length < 4) { return -1; }
    var cx = (b[0] + b[2]) / 2, cy = (b[1] + b[3]) / 2, i, r;
    for (i = 0; i < doc.artboards.length; i++) {
        r = doc.artboards[i].artboardRect;
        if (cx >= r[0] && cx <= r[2] && cy <= r[1] && cy >= r[3]) { return i; }
    }
    return -1;
};
SDY.tag = function (it, p) {
    it.name = p.name || p.id;
    it.note = "sdy:" + p.kind + "|" + p.id + "|" + (p.mock_hash || "");
};
SDY.parseTag = function (it) {
    var n = "";
    try { n = it.note; } catch (e) { return null; }
    if (!n || n.indexOf("sdy:") !== 0) { return null; }
    var a = n.substring(4).split("|");
    return { kind: a[0], id: a[1], mock_hash: a[2] || "" };
};
// 文字の体裁。Illustratorは文字の範囲によって Error 9503（illegal text range）を出すことがあるので、
// 属性は一つずつ try で掛け、全体に掛けられなければ段落ごと・文字ごとに掛ける（10-25、ユーザーの試運転で9503）
SDY._each = function (tf, fn) {
    try { fn(tf.textRange); return; } catch (e0) {}
    var k, ok = false;
    try { for (k = 0; k < tf.paragraphs.length; k++) { try { if (tf.paragraphs[k].length > 0) { fn(tf.paragraphs[k]); ok = true; } } catch (e1) {} } } catch (e2) {}
    if (ok) { return; }
    try { for (k = 0; k < tf.characters.length; k++) { try { fn(tf.characters[k]); } catch (e3) {} } } catch (e4) {}
};
SDY.styleText = function (tf, p) {
    var f = SDY.font(p.font), size = Number(p.size_pt), lead = Number(p.leading || 1.5);
    if (!(size > 0.1 && size < 1296)) { size = 10; }
    var jus = (p.justify === "full_last_left") ? Justification.FULLJUSTIFYLASTLINELEFT :
              ((p.align === "center") ? Justification.CENTER : ((p.align === "right") ? Justification.RIGHT : Justification.LEFT));
    // 段落は両端揃え・最終行は左（ユーザー 10-25夕）、一字下げしない、段落のあいだは1行分、行送り＝文字の1.5倍
    SDY._each(tf, function (r) { r.characterAttributes.size = size; });
    if (f) { SDY._each(tf, function (r) { r.characterAttributes.textFont = f; }); }
    SDY._each(tf, function (r) { r.characterAttributes.fillColor = SDY.rgb(p.color); });
    SDY._each(tf, function (r) { r.characterAttributes.autoLeading = false; r.characterAttributes.leading = size * lead; });
    SDY._each(tf, function (r) { r.paragraphAttributes.justification = jus; });
    SDY._each(tf, function (r) { r.paragraphAttributes.firstLineIndent = 0; });
    if (p.para_space) { SDY._each(tf, function (r) { r.paragraphAttributes.spaceAfter = size * Number(p.para_space); }); }
    // 段落ごとの書式（3枚目の inspired by と面積表の列、10-29）：para_styles[k] = {size_pt, font, color, leading_pt}
    if (p.para_styles) {
        var k, pr, st;
        for (k = 0; k < p.para_styles.length; k++) {
            st = p.para_styles[k];
            try { pr = tf.paragraphs[k]; } catch (e5) { break; }
            if (!pr || !st) { continue; }
            try { if (pr.length === 0) { continue; } } catch (e6) {}
            try { if (st.size_pt) { pr.characterAttributes.size = Number(st.size_pt); } } catch (e7) {}
            try { var ff = SDY.font(st.font); if (ff) { pr.characterAttributes.textFont = ff; } } catch (e8) {}
            try { if (st.color) { pr.characterAttributes.fillColor = SDY.rgb(st.color); } } catch (e9) {}
            try { if (st.leading_pt) { pr.characterAttributes.autoLeading = false; pr.characterAttributes.leading = Number(st.leading_pt); } } catch (e10) {}
            if (st.tail) {                            // 段落の後ろの区間だけ別の書式（inspired by の名前の後ろの出どころ、10-30）
                try {
                    var tf_ = SDY.font(st.tail.font), j_;
                    for (j_ = st.tail.from; j_ < pr.characters.length; j_++) {
                        var ca_ = pr.characters[j_].characterAttributes;
                        if (st.tail.size_pt) { ca_.size = Number(st.tail.size_pt); }
                        if (tf_) { ca_.textFont = tf_; }
                        if (st.tail.color) { ca_.fillColor = SDY.rgb(st.tail.color); }
                    }
                } catch (e11) {}
            }
        }
    }
};
// 文字の書式（書体・大きさ・色・行送り）：.ai で変えた書式を書き出し、build・update_texts で当て直す（ユーザー 10-29 15:33）
SDY.fontName = function (f) { try { return f.name; } catch (e) { return null; } };
SDY.runsOf = function (tf) {                         // 段落ごとの、書式のそろった区間 [{para, off, len, font, size_pt, color, leading_pt}]
    var out = [], k, pr, n, j, c, a, cur = null, key, ca;
    for (k = 0; k < tf.paragraphs.length; k++) {
        try { pr = tf.paragraphs[k]; n = pr.characters.length; } catch (e) { continue; }
        cur = null;
        for (j = 0; j < n; j++) {
            try { c = pr.characters[j]; ca = c.characterAttributes; } catch (e1) { continue; }
            a = { font: SDY.fontName(ca.textFont), size_pt: Math.round(ca.size * 100) / 100, color: SDY.hexOf(ca.fillColor),
                  leading_pt: ca.autoLeading ? null : Math.round(ca.leading * 100) / 100 };
            key = a.font + "|" + a.size_pt + "|" + a.color + "|" + a.leading_pt;
            if (cur && cur.key === key) { cur.len++; continue; }
            cur = { key: key, para: k, off: j, len: 1, font: a.font, size_pt: a.size_pt, color: a.color, leading_pt: a.leading_pt };
            out.push(cur);
        }
    }
    for (k = 0; k < out.length; k++) { delete out[k].key; }
    return out;
};
SDY.expectStyle = function (p, k) {                  // layout.json の部品が決めた、段落 k の書式
    var st = (p.para_styles && p.para_styles[k]) || {}, f = SDY.font(st.font || p.font);
    var size = Number(st.size_pt || p.size_pt), lead = st.leading_pt ? Number(st.leading_pt) : size * Number(p.leading || 1.5);
    return { font: SDY.fontName(f), size_pt: Math.round(size * 100) / 100, color: String(st.color || p.color || "#222222").toLowerCase(), leading_pt: Math.round(lead * 100) / 100 };
};
SDY.styleDiff = function (tf, p) {                   // 書き出し：layout.json と違う区間だけ
    var runs = SDY.runsOf(tf), out = [], k, r, e;
    for (k = 0; k < runs.length; k++) {
        r = runs[k]; e = SDY.expectStyle(p, r.para);
        if (r.font !== e.font || Math.abs(r.size_pt - e.size_pt) > 0.05 || String(r.color).toLowerCase() !== e.color ||
            (r.leading_pt !== null && Math.abs(r.leading_pt - e.leading_pt) > 0.1)) { out.push(r); }
    }
    return out;
};
SDY.applyRuns = function (tf, runs, id) {            // 区間ごとに当てる。段落の番号で当て、段落が足りない・短いときは当てずに一覧へ
    var k, r, pr, j, ca, f, bad = 0;
    for (k = 0; k < (runs || []).length; k++) {
        r = runs[k];
        try { pr = tf.paragraphs[r.para]; } catch (e) { pr = null; }
        if (!pr || pr.characters.length < r.off + r.len) { bad++; continue; }
        f = null; if (r.font) { try { f = app.textFonts.getByName(r.font); } catch (e1) { f = null; } }
        for (j = r.off; j < r.off + r.len; j++) {
            try {
                ca = pr.characters[j].characterAttributes;
                if (f) { ca.textFont = f; }
                if (r.size_pt) { ca.size = Number(r.size_pt); }
                if (r.color) { var c = SDY.colorOf(r.color); if (c) { ca.fillColor = c; } }
                if (r.leading_pt) { ca.autoLeading = false; ca.leading = Number(r.leading_pt); }
            } catch (e2) {}
        }
    }
    if (bad) { SDY.missing.push("書式を当てられなかった（文が変わって段落が合わない）：" + id + "（" + bad + " か所）"); }
};
// 重ね順（ユーザー 10-29 17:39）：重ね順はレイヤーの中だけで効く。layout.json の order（グループ a を b の上に）と、
// 書き出した layout_user.json の stacking（レイヤーごとの、いちばん上の階の物の上からの並び）を build・update_texts の終わりに当てる
SDY.topOf = function (it) { var q = it; try { while (q.parent && q.parent.typename !== "Layer") { q = q.parent; } } catch (e) {} return q; };
SDY.firstTagIn = function (it) {                    // グループの中の、いちばん初めの印の付いた部品の id（無ければ null）
    var k, t, r;
    if (it.typename !== "GroupItem") { return null; }
    for (k = 0; k < it.pageItems.length; k++) {
        t = SDY.parseTag(it.pageItems[k]); if (t) { return t.id; }
        r = SDY.firstTagIn(it.pageItems[k]); if (r) { return r; }
    }
    return null;
};
SDY.firstUserIn = function (it) {                   // グループの中の、いちばん初めの木田さんの物の鍵
    var k, u, r;
    if (it.typename !== "GroupItem") { return null; }
    for (k = 0; k < it.pageItems.length; k++) {
        u = SDY.userKey(it.pageItems[k]); if (u) { return u; }
        r = SDY.firstUserIn(it.pageItems[k]); if (r) { return r; }
    }
    return null;
};
SDY.stackKey = function (it) {
    // レイヤーのすぐ下の物の鍵（10-30：レイヤーは完璧に覚える）。グループは中の印の付いた部品で覚える（名前は同じものがあり、変わることもある）
    var t = SDY.parseTag(it), u = SDY.userKey(it), d;
    if (t) { return "t:" + t.id; }
    if (u) { return "u:" + u; }
    if (it.typename === "GroupItem") {
        d = SDY.firstTagIn(it); if (d) { return "d:" + d; }
        d = SDY.firstUserIn(it); if (d) { return "e:" + d; }
        if (it.name) { return "g:" + it.name; }
    }
    return null;
};
SDY.stackingOf = function (doc, rid) {               // 書き出し：{レイヤーの名前: [鍵（上から）]}
    var out = {}, i, k, L, it, key, arr;
    for (i = 0; i < doc.layers.length; i++) {
        L = doc.layers[i]; arr = [];
        for (k = 0; k < L.pageItems.length; k++) {
            it = L.pageItems[k];
            try { if (it.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
            key = SDY.stackKey(it);
            if (key && (key.indexOf("t:") === 0 || key.indexOf("d:") === 0) && rid) { key = key.substring(0, 2) + rid(key.substring(2)); }
            if (key) { arr.push(key); }
        }
        if (arr.length) { out[L.name] = arr; }
    }
    return out;
};
SDY.findGroupTop = function (doc, name, lay) {       // いちばん上の階の、名前のグループ（レイヤーを指せばそのレイヤーを先に）
    var i, g, cand = null;
    for (i = 0; i < doc.groupItems.length; i++) {
        g = doc.groupItems[i];
        try { if (g.name !== name || g.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
        if (!lay || g.layer === lay) { return g; }
        if (!cand) { cand = g; }
    }
    return cand;
};
SDY.applyOrder = function (doc, L) {                 // layout.json の order：{layer, name, above}（name のグループを above のグループのすぐ上に）
    var k, r, lay, a, b, n = 0;
    for (k = 0; k < ((L && L.order) || []).length; k++) {
        r = L.order[k];
        try {
            lay = SDY.layer(doc, r.layer);
            a = SDY.findGroupTop(doc, r.name, lay); b = SDY.findGroupTop(doc, r.above, lay);
            if (!a || !b) { continue; }
            if (a.layer !== lay) { a.move(lay, ElementPlacement.PLACEATBEGINNING); }
            if (b.layer !== lay) { continue; }
            a.move(b, ElementPlacement.PLACEBEFORE); n++;
        } catch (e) { SDY.missing.push("重ね順（" + r.name + "）：" + e.message); }
    }
    return n;
};
SDY.applyStacking = function (doc, U) {              // layout_user.json の stacking：書き出したときの並びに（レイヤーを移した物はそのレイヤーへ）
    if (!U || !U.stacking) { return 0; }
    var map = SDY.findByTag(doc), um = SDY.userKeys(doc), ln, arr, lay, k, key, it, n = 0;
    for (ln in U.stacking) {
        if (!U.stacking.hasOwnProperty(ln)) { continue; }
        arr = U.stacking[ln];
        try { lay = doc.layers.getByName(ln); } catch (e) { continue; }   // 編集モードなどの無いレイヤーは飛ばす
        for (k = arr.length - 1; k >= 0; k--) {                          // 下から順に上へ積む
            key = arr[k]; it = null;
            if (key.indexOf("t:") === 0 || key.indexOf("d:") === 0) { it = map[key.substring(2)]; }
            else if (key.indexOf("u:") === 0 || key.indexOf("e:") === 0) { it = um[key.substring(2)]; }
            else if (key.indexOf("g:") === 0) { it = SDY.findGroupTop(doc, key.substring(2), lay); }
            if (!it) { continue; }
            it = SDY.topOf(it);
            try { it.move(lay, ElementPlacement.PLACEATBEGINNING); n++; } catch (e1) {}
        }
    }
    return n;
};
SDY.missing = [];
// 作れなかった部品（10-30：編集モードで update_texts が作れなかった寸法を、書き出しが「消した」と記録した）。
// build・update_texts が failed_parts.json に書き、export_layout はそこにある部品を「消した」にしない
SDY.failed = {};
SDY.writeFailed = function () {
    var a = [], k; for (k in SDY.failed) { if (SDY.failed.hasOwnProperty(k)) { a.push(SDY.q(k)); } }
    try { SDY.writeText(File(SDY.here.fsName + "/failed_parts.json"), "[" + a.join(",") + "]\n"); } catch (e) {}
};
SDY.readFailed = function () {
    var m = {}, a, k; try { a = SDY.readJSON(File(SDY.here.fsName + "/failed_parts.json")); for (k = 0; k < a.length; k++) { m[a[k]] = true; } } catch (e) {}
    return m;
};
// 5枚の番号の振り直し（ユーザー、10-28・10-28 13:17）：layout.json の renumber.maps（前の番号 → 新しい番号）。
// 前に組んだときの layout_built.json の renumber の id で、今の .ai がどの番号かを見る（renumber が無ければ最初の番号＝"_none"）。
// 今の番号のままなら null、前の番号なら写し方（{"前": 新, …}）を返す
SDY.oldNumbering = function (L) {
    if (!L || !L.renumber || !L.renumber.maps) { return null; }
    var OB = null;
    try { var bf = File(SDY.here.fsName + "/layout_built.json"); if (bf.exists) { OB = SDY.readJSON(bf); } } catch (e) {}
    var was = (OB && OB.renumber) ? OB.renumber.id : "_none";
    if (was === L.renumber.id) { return null; }
    return L.renumber.maps[was] || null;
};
// 枚が分かれた部品（10-30、6枚）：layout.json の renumber.split（前に組んだときの id ごと、部品の名前の頭 → 新しい頭）。無ければ null
SDY.oldSplit = function (L) {
    if (!L || !L.renumber || !L.renumber.split || !SDY.oldNumbering(L)) { return null; }
    var OB = null;
    try { var bf = File(SDY.here.fsName + "/layout_built.json"); if (bf.exists) { OB = SDY.readJSON(bf); } } catch (e) {}
    var was = (OB && OB.renumber) ? OB.renumber.id : "_none";
    return L.renumber.split[was] || null;
};
// 前の番号の名前 → 今の名前。split の頭に当たれば（長い方が先）それで、無ければ枚の番号の写し方（RN）で。戻り値 [名前, split に当たったか]
SDY.renameOld = function (id, RN, SP) {
    var best = "", k;
    if (SP) { for (k in SP) { if (SP.hasOwnProperty(k) && id.indexOf(k) === 0 && k.length > best.length) { best = k; } } }
    if (best) { return [SP[best] + id.substring(best.length), true]; }
    var m = /^p(\d+)\./.exec(id);
    return [(RN && m && RN[m[1]]) ? "p" + RN[m[1]] + id.substring(m[0].length - 1) : id, false];
};
SDY.abMap = null;                                    // 前の .ai のアートボード番号（0から）→ 新しい .ai のアートボード番号
SDY.placeLink = function (doc, lay, i, p) {
    var f = File(SDY.root.fsName + "/" + p.file);
    if (!f.exists) { SDY.missing.push(p.file); return null; }
    app.preferences.PDFFileOptions.pageToOpen = p.page || 1;
    try { app.preferences.PDFFileOptions.pDFCropToBox = PDFBoxType.PDFMEDIABOX; } catch (e) {}
    var it = lay.placedItems.add();
    it.file = f;
    var tl = SDY.P(doc, i, p.x, p.y), s = p.scale || 1, K = SDY.K;
