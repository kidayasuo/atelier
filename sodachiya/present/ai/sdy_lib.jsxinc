        tri.closed = true; tri.stroked = false; tri.filled = true; tri.fillColor = SDY.rgb(p.color);
        pi.setEntirePath(pts.slice(0, pts.length - 1).concat([[b[0] - ux * L * 0.8, b[1] - uy * L * 0.8]]));   // 線は矢じりの中で止める
    }
