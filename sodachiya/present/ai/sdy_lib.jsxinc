        it = doc.pageItems[i];
        t = SDY.parseTag(it);
        if (t) { map[t.id] = it; }
    }
    return map;
};

// 箱と文字をひとまとめに（ユーザー 10-25：箱を動かせば文字も動く）。箱・見出し・本文を、箱の名前のグループに入れる
SDY.groupBoxes = function (doc) {
    var map = SDY.findByTag(doc), id, it, t, n = 0, g, h, b;
    for (id in map) {
        if (!map.hasOwnProperty(id)) { continue; }
        it = map[id]; t = SDY.parseTag(it);
        if (!t || t.kind !== "box") { continue; }
        if (it.parent.typename === "GroupItem") { continue; }   // もうまとめてある・印の□（数字とのグループ、10-28）
        g = it.layer.groupItems.add(); g.name = it.name;
        g.move(it, ElementPlacement.PLACEBEFORE);
        it.move(g, ElementPlacement.PLACEATEND);
        h = map[id + ".head"]; b = map[id + ".body"];
        if (h) { h.move(g, ElementPlacement.PLACEATBEGINNING); }
        if (b) { b.move(g, ElementPlacement.PLACEATBEGINNING); }
        n++;
    }
    return n;
};
// 引き出し線を箱に付け直す（箱を動かした後に）。線の終わり（点）は動かさず、始まりを箱の縁の、点に近い側へ
SDY.leaderBoxMap = function (L) {                   // layout.json から 線のid → 箱のid（線の始まりが箱の縁にあるもの）
    var m = {}, i, j, k, p, q, s0, ok;
    for (i = 0; i < L.pages.length; i++) {
        for (j = 0; j < L.pages[i].parts.length; j++) {
            p = L.pages[i].parts[j];
            if (p.kind !== "line" || !p.pts || p.pts.length < 2) { continue; }
            s0 = p.pts[0];
            for (k = 0; k < L.pages[i].parts.length; k++) {
                q = L.pages[i].parts[k];
                if (q.kind !== "box") { continue; }
                ok = s0[0] >= q.x - 1.5 && s0[0] <= q.x + q.w + 1.5 && s0[1] >= q.y - 1.5 && s0[1] <= q.y + q.h + 1.5;
                if (ok) { m[p.id] = q.id; break; }
            }
        }
    }
    return m;
};
SDY.reconnect = function (doc, L) {
    var map = SDY.findByTag(doc), lb = SDY.leaderBoxMap(L), id, ln, bx, k, path, dot, tgt, gb, sx, sy, K = SDY.K, n = 0, pp;
    for (id in lb) {
        if (!lb.hasOwnProperty(id)) { continue; }
        ln = map[id]; bx = map[lb[id]];
        if (!ln || !bx || ln.typename !== "GroupItem") { continue; }
        path = null; dot = null;
        for (k = 0; k < ln.pathItems.length; k++) { if (ln.pathItems[k].closed) { dot = ln.pathItems[k]; } else { path = ln.pathItems[k]; } }
        if (!path) { continue; }
        if (dot) { gb = dot.geometricBounds; tgt = [(gb[0] + gb[2]) / 2, (gb[1] + gb[3]) / 2]; }
        else { pp = path.pathPoints; tgt = pp[pp.length - 1].anchor; }
        gb = bx.geometricBounds;                        // [左, 上, 右, 下]（上の方が大きい）
        if (tgt[0] >= gb[2]) { sx = gb[2]; } else if (tgt[0] <= gb[0]) { sx = gb[0]; }
        else { sx = (Math.abs(tgt[0] - gb[0]) < Math.abs(tgt[0] - gb[2])) ? gb[0] : gb[2]; }
        sy = Math.max(gb[3] + 3 * K, Math.min(gb[1] - 3 * K, tgt[1]));
        path.setEntirePath([[sx, sy], [tgt[0], tgt[1]]]);
        n++;
    }
    return n;
};

// 木田さんが足した物（部品の印 sdy: の無い物）：書き出して台帳に残し、組み直しのときは前の .ai から写す（ユーザー、10-26）
SDY.hasTag = function (it) {
    if (SDY.parseTag(it)) { return true; }
    if (it.typename === "GroupItem") {
        var k;
        for (k = 0; k < it.pageItems.length; k++) { if (SDY.hasTag(it.pageItems[k])) { return true; } }
    }
    return false;
};
SDY.isOurs = function (it) {
    if (it.typename === "SymbolItem" && it.name === "枠") { return true; }
    return SDY.hasTag(it);
};
SDY.userItems = function (doc) {                     // レイヤーのいちばん上の階の物のうち、印の無いもの
    var out = [], i, k, L, it;
    for (i = 0; i < doc.layers.length; i++) {
        L = doc.layers[i];
        for (k = 0; k < L.pageItems.length; k++) {
            it = L.pageItems[k];
            try { if (it.parent.typename !== "Layer") { continue; } } catch (e) { continue; }
            if (!SDY.isOurs(it)) { out.push(it); }
            else if (it.typename === "GroupItem" && !SDY.parseTag(it)) { SDY.userInGroup(it, out); }   // 部品のグループ（配置図の切り抜きなど）に入れた木田さんの物も（10-28：風の線が消えた）
        }
    }
    return out;
};
SDY.userInGroup = function (g, out) {               // 印の無いグループの中の、印の無い物（切り抜きの四角は除く）
    var k, c, clip;
    for (k = 0; k < g.pageItems.length; k++) {
        c = g.pageItems[k];
        if (SDY.parseTag(c)) { continue; }
        clip = false; try { clip = c.clipping; } catch (e) {}
        if (clip) { continue; }
        if (c.typename === "GroupItem" && SDY.hasTag(c)) { SDY.userInGroup(c, out); } else { out.push(c); }
    }
};
// 線の部品（グループ）の塗り：最初の塗りのあるパスの色（ゾーニングの区分に木田さんが付けた塗り、10-31）。無ければ null
SDY.fillOf = function (it) {
    var k, c, f = null;
    try {
        if (it.typename === "PathItem") { return it.filled ? SDY.hexOf(it.fillColor) : null; }
        if (it.typename === "CompoundPathItem") { return it.pathItems.length ? SDY.fillOf(it.pathItems[0]) : null; }
        if (it.typename === "GroupItem") { for (k = 0; k < it.pageItems.length && !f; k++) { f = SDY.fillOf(it.pageItems[k]); } }
    } catch (e) {}
    return f;
};
SDY.setFill = function (it, hex) {
    var k;
    try {
        if (it.typename === "PathItem") { it.filled = true; it.fillColor = SDY.rgb(hex); return; }
        if (it.typename === "CompoundPathItem" || it.typename === "GroupItem") { for (k = 0; k < it.pageItems.length; k++) { SDY.setFill(it.pageItems[k], hex); } }
        if (it.typename === "CompoundPathItem") { for (k = 0; k < it.pathItems.length; k++) { SDY.setFill(it.pathItems[k], hex); } }
    } catch (e) {}
};
SDY.hexOf = function (c) {
    try {
        if (c.typename === "RGBColor") {
            var h = function (v) { var t = Math.round(v).toString(16); return t.length < 2 ? "0" + t : t; };
            return "#" + h(c.red) + h(c.green) + h(c.blue);
        }
        if (c.typename === "GrayColor") { return "gray" + Math.round(c.gray); }
        if (c.typename === "NoColor") { return null; }
        return c.typename;
    } catch (e) { return null; }
};
SDY.describe = function (doc, it) {                   // 台帳に残す中身（mm、アートボードの左上から）
    var b = it.geometricBounds, ai = SDY.abOf(doc, b), r = SDY.ab(doc, ai < 0 ? 0 : ai), K = SDY.K, d, k, pp;
    var mm = function (p) { return [Math.round((p[0] - r[0]) / K * 100) / 100, Math.round((r[1] - p[1]) / K * 100) / 100]; };
    d = { type: it.typename, name: it.name || "", layer: it.layer.name, artboard: ai + 1,
          x: mm([b[0], b[1]])[0], y: mm([b[0], b[1]])[1], w: Math.round((b[2] - b[0]) / K * 100) / 100, h: Math.round((b[1] - b[3]) / K * 100) / 100 };
    try { d.opacity = it.opacity; } catch (e) {}
    if (it.typename === "PathItem") {
        d.closed = it.closed;
        d.fill = it.filled ? SDY.hexOf(it.fillColor) : null;
        d.stroke = it.stroked ? SDY.hexOf(it.strokeColor) : null;
        if (it.stroked) { d.stroke_pt = it.strokeWidth; }
        d.pts = [];
        for (k = 0; k < it.pathPoints.length; k++) {
            pp = it.pathPoints[k];
            d.pts.push([mm(pp.anchor), mm(pp.leftDirection), mm(pp.rightDirection)]);
        }
    } else if (it.typename === "TextFrame") {
        d.s = SDY.norm(it.contents);
        try {                                         // 段落の枠（エリア内文字）は枠の大きさも（ユーザー 10-30：幅を狭くしても build で戻った）
            if (it.kind === TextType.AREATEXT) {
                var tb = it.textPath.geometricBounds, tp = mm([tb[0], tb[1]]);
                d.area = true; d.x = tp[0]; d.y = tp[1];
                d.w = Math.round((tb[2] - tb[0]) / K * 100) / 100; d.h = Math.round((tb[1] - tb[3]) / K * 100) / 100;
            }
        } catch (e9) {}
        try { d.size_pt = it.textRange.characterAttributes.size; } catch (e) {}
        try { d.color = SDY.hexOf(it.textRange.characterAttributes.fillColor); } catch (e) {}
        try { d.font = SDY.fontName(it.textRange.characterAttributes.textFont); } catch (e) {}
        try { var rs_ = SDY.runsOf(it); if (rs_.length > 1) { d.runs = rs_; } } catch (e) {}
    } else if (it.typename === "GroupItem" || it.typename === "CompoundPathItem") {
        d.children = [];
        var ch = it.typename === "GroupItem" ? it.pageItems : it.pathItems;
        for (k = 0; k < ch.length && k < 50; k++) { try { d.children.push(SDY.describe(doc, ch[k])); } catch (e) {} }
    } else if (it.typename === "PlacedItem" || it.typename === "RasterItem") {
        try { d.file = it.file.fsName; } catch (e) {}
    }
    return d;
};
SDY.copyUserItems = function (src, dst, known) {      // 前の .ai の木田さんの物を、新しい .ai の同じレイヤー・同じアートボードの同じ位置へ
    // known：layout_user.json にある鍵（user_items と deleted_user）。それらは json から描く・消したので写さない。写すのはまだ書き出していない物だけ（補助、10-29）
    var items = SDY.userItems(src), n = 0, i, it, ai, ra, rb, dup, lay, uk;
    for (i = items.length - 1; i >= 0; i--) {
        it = items[i];
        uk = SDY.userKey(it);
        if (uk && known && known[uk]) { continue; }
        try {
            ai = SDY.abOf(src, it.geometricBounds);
            lay = SDY.userLayer(dst, it.layer.name);
            dup = it.duplicate(lay, ElementPlacement.PLACEATBEGINNING);
            if (ai >= 0 && ai < dst.artboards.length) {
                var bi = SDY.abMap ? SDY.abMap(ai) : ai;      // 番号を振り直したときは新しい番号のアートボードへ
                ra = src.artboards[ai].artboardRect; rb = dst.artboards[bi].artboardRect;
                dup.translate(rb[0] - ra[0], rb[1] - ra[1]);
                var sp = SDY.planShift, gb = it.geometricBounds;
                if (sp && bi === sp.ab) {                  // 配置図の上に描いた物は、配置図が紙の上で動いた分だけ一緒に動かし、配置図のまとめに入れる（10-28）
                    var cx = ((gb[0] + gb[2]) / 2 - ra[0]) / SDY.K, cy = (ra[1] - (gb[1] + gb[3]) / 2) / SDY.K, w = sp.win;
                    if (cx >= w[0] && cx <= w[0] + w[2] && cy >= w[1] && cy <= w[1] + w[3]) {
                        if (Math.abs(sp.dx) > 0.05 || Math.abs(sp.dy) > 0.05) { dup.translate(sp.dx * SDY.K, -sp.dy * SDY.K); }
                        sp.n++; SDY.planUser.push(dup);
                    }
                }
            }
            n++;
        } catch (e) { SDY.missing.push("木田さんの物（" + (it.name || it.typename) + "）を写せなかった：" + e.message); }
    }
    return n;
};

// 木田さんが足した物の正本は layout_user.json の user_items（ユーザー 10-29 14:24：build で風の矢印が消えた）。
// 書き出しのときに一つずつ印 "sdyu:<鍵>" を付け（部品の印 "sdy:" とは別）、build と update_texts は user_items から描き直す
SDY.UKEY = "sdyu:";
SDY.userKey = function (it) { var n = ""; try { n = it.note; } catch (e) { return null; } return (n && n.indexOf(SDY.UKEY) === 0) ? n.substring(SDY.UKEY.length) : null; };
SDY.userKeys = function (doc) {                      // 鍵 → 物（.ai の中の、印の付いた木田さんの物）
    var m = {}, i, k;
    for (i = 0; i < doc.pageItems.length; i++) { k = SDY.userKey(doc.pageItems[i]); if (k) { m[k] = doc.pageItems[i]; } }
    return m;
};
SDY.colorOf = function (v) {                         // describe の色（#rrggbb・grayNN）→ Illustrator の色
    if (!v) { return null; }
    v = String(v);
    if (v.charAt(0) === "#") { return SDY.rgb(v); }
    var m = /^gray(\d+)$/.exec(v);
    if (m) { var g = Math.round(255 * (1 - Number(m[1]) / 100)), h = ("0" + g.toString(16)).slice(-2); return SDY.rgb("#" + h + h + h); }
    return null;
};
SDY.userLayer = function (doc, name) {               // 編集モード（分離）で書き出したときのレイヤーの名前は使わない
    if (!name || name === "編集モード" || name === "Isolation Mode") { name = "説明"; }
    return SDY.layer(doc, name);
};
SDY.drawUser = function (doc, ai, d, dx, dy, cont) {  // describe の形から描き直す（mm、アートボードの左上から。dx・dy は配置図と一緒に動かす分）
    var r = SDY.ab(doc, ai), K = SDY.K, k, it = null, c;
    var P = function (q) { return [r[0] + (q[0] + dx) * K, r[1] - (q[1] + dy) * K]; };
    var fillPath = function (pi, e) {
        var pp, m, q;
        for (m = 0; m < e.pts.length; m++) {
            q = e.pts[m];
            if (typeof q[0] === "number") { q = [q, q, q]; }   // 点だけの形（[x, y]）も
            pp = pi.pathPoints.add();
            pp.anchor = P(q[0]); pp.leftDirection = P(q[1] || q[0]); pp.rightDirection = P(q[2] || q[0]);
        }
        pi.closed = !!e.closed;
        c = SDY.colorOf(e.fill); pi.filled = !!c; if (c) { pi.fillColor = c; }
        c = SDY.colorOf(e.stroke); pi.stroked = !!c; if (c) { pi.strokeColor = c; pi.strokeWidth = Number(e.stroke_pt || 1); }
    };
    if (d.type === "PathItem" && d.pts) {
        it = cont.pathItems.add(); fillPath(it, d);
    } else if (d.type === "CompoundPathItem") {
        it = cont.compoundPathItems.add();
        for (k = (d.children || []).length - 1; k >= 0; k--) { if (d.children[k].pts) { fillPath(it.pathItems.add(), d.children[k]); } }
    } else if (d.type === "GroupItem") {
        it = cont.groupItems.add();
        var j;
        for (j = (d.children || []).length - 1; j >= 0; j--) { try { SDY.drawUser(doc, ai, d.children[j], dx, dy, it); } catch (e1) { SDY.missing.push("足した物の中（" + (d.children[j].name || d.children[j].type) + "）：" + e1.message); } }
    } else if (d.type === "TextFrame" && d.s !== undefined) {
        if (d.area && d.w && d.h) {                   // エリア内文字：同じ枠で（10-30）
            var q0 = P([d.x, d.y]);
            it = cont.textFrames.areaText(cont.pathItems.rectangle(q0[1], q0[0], d.w * K, d.h * K));
        } else {
            it = cont.textFrames.pointText(P([d.x, d.y + (d.h || 4) * 0.8]));
        }
        it.contents = String(d.s).replace(/\n/g, "\r");
        try { if (d.size_pt) { it.textRange.characterAttributes.size = Number(d.size_pt); } } catch (e2) {}
        try { c = SDY.colorOf(d.color); if (c) { it.textRange.characterAttributes.fillColor = c; } } catch (e3) {}
        try { if (d.font) { it.textRange.characterAttributes.textFont = app.textFonts.getByName(d.font); } } catch (e5) {}
        if (d.runs) { SDY.applyRuns(it, d.runs, "足した文字 " + (d.name || d.s.substring(0, 12))); }
    } else if ((d.type === "PlacedItem" || d.type === "RasterItem") && d.file && File(d.file).exists) {
        it = cont.placedItems.add(); it.file = File(d.file);
        it.width = d.w * K; it.height = d.h * K; it.position = P([d.x, d.y]);
    }
    if (!it) { return null; }
    if (d.name) { it.name = d.name; }
    try { if (d.opacity !== undefined && d.opacity !== null) { it.opacity = Number(d.opacity); } } catch (e4) {}
    return it;
};
// layout_user.json の user_items のうち、.ai にまだ無い物（鍵で見る）を描く。配置図の上の物は配置図と一緒に動かし、配置図のまとめへ。返り値は描いた数
SDY.drawUserItems = function (doc, L, U) {
    if (!U || !U.user_items) { return 0; }
    var have = SDY.userKeys(doc), n = 0, i, d, ai, pg, dx, dy, cont, it, gi, an, au, inWin;
    an = (L && L.anchors) ? L.anchors["p1.siteplan"] : null;
    au = (U.anchors) ? U.anchors["p1.siteplan"] : null;
    var sdx = (an && au) ? an.origin[0] - au.origin[0] : 0, sdy = (an && au) ? an.origin[1] - au.origin[1] : 0;
    for (i = 0; i < U.user_items.length; i++) {
        d = U.user_items[i];
        if (!d || (d.key && have[d.key])) { continue; }
        ai = -1;
        for (pg = 0; pg < L.pages.length; pg++) { if (L.pages[pg].no === d.artboard) { ai = pg; } }
        if (ai < 0) { SDY.missing.push("足した物の枚が無い：" + (d.name || d.type)); continue; }
        inWin = false;
        if (d.artboard === 1 && au && au.window) {
            var cx = d.x + d.w / 2, cy = d.y + d.h / 2, w = au.window;
            inWin = d.plan || (cx >= w[0] && cx <= w[0] + w[2] && cy >= w[1] && cy <= w[1] + w[3]);
        }
        dx = inWin ? sdx : 0; dy = inWin ? sdy : 0;
        cont = SDY.userLayer(doc, d.layer);
        if (d.group && d.group !== SDY.PLAN_GROUP) {
            for (gi = 0; gi < doc.groupItems.length; gi++) { if (doc.groupItems[gi].name === d.group) { cont = doc.groupItems[gi]; break; } }
        }
        try {
            it = SDY.drawUser(doc, ai, d, dx, dy, cont);
            if (!it) { SDY.missing.push("足した物を描けなかった：" + (d.name || d.type)); continue; }
            if (d.key) { it.note = SDY.UKEY + d.key; }
            if (inWin && cont.typename === "Layer") { SDY.planUser.push(it); }
            n++;
        } catch (e) { SDY.missing.push("足した物（" + (d.name || d.type) + "）：" + e.message); }
    }
    return n;
};

// 配置図のまとめ（ユーザー、10-28 18:03：配置図の位置に依存する物は全てグループに）
SDY.planUser = [];                                   // 前の .ai から写した、配置図の上の木田さんの物（copyUserItems が入れる）
SDY.PLAN_GROUP = "配置図（まとめ）";
// .ai の配置図の原点（紙の左上から mm）と切り抜きの四角：素材01aの左上 ＋ 素材の中の原点の位置（組んだときの目印 ao の mat、無ければ前の描き方 mat_legacy）
SDY.planOrigin = function (doc, ao, an) {
    var map = SDY.findByTag(doc), it = map["p1.sozai.01a"], K = SDY.K, b, ai, r, x, y, h, mo, out = null, k, i, cg, cb;
    if (!it) { return null; }
    b = it.geometricBounds; ai = SDY.abOf(doc, b); if (ai < 0) { ai = 0; }
    r = SDY.ab(doc, ai);
    x = (b[0] - r[0]) / K; y = (r[1] - b[1]) / K; h = (b[1] - b[3]) / K;
    mo = (ao && ao.mat) ? ao.mat : ((an && an.mat_legacy) ? [an.mat_legacy[0], h + an.mat_legacy[1]] : null);
    if (!mo) { return null; }
    out = { origin: [x + mo[0], y + mo[1]], window: SDY.clipWindow(doc) };
    return out;
};
SDY.clipWindow = function (doc) {                     // 配置図の切り抜きの四角（1枚目の左上から mm）
    var i, k, cg, cb, ai, r, K = SDY.K;
    for (i = 0; i < doc.groupItems.length; i++) {
        cg = doc.groupItems[i];
        if (cg.name !== "配置図（切り抜き）" || !cg.clipped) { continue; }
        for (k = 0; k < cg.pathItems.length; k++) {
            if (!cg.pathItems[k].clipping) { continue; }
            cb = cg.pathItems[k].geometricBounds; ai = SDY.abOf(doc, cb); r = SDY.ab(doc, ai < 0 ? 0 : ai);
            return [(cb[0] - r[0]) / K, (r[1] - cb[1]) / K, (cb[2] - cb[0]) / K, (cb[1] - cb[3]) / K];
        }
    }
    return null;
};
SDY.planUserIn = function (doc, ab) {               // 開いている .ai の、配置図の切り抜きの上にある木田さんの物（update_texts 用）
    var w = SDY.clipWindow(doc), items = SDY.userItems(doc), k, gb, r, cx, cy, out = [];
    if (!w) { return out; }
    r = SDY.ab(doc, ab);
    for (k = 0; k < items.length; k++) {
        gb = items[k].geometricBounds;
        if (SDY.abOf(doc, gb) !== ab) { continue; }
        cx = ((gb[0] + gb[2]) / 2 - r[0]) / SDY.K; cy = (r[1] - (gb[1] + gb[3]) / 2) / SDY.K;
        if (cx >= w[0] && cx <= w[0] + w[2] && cy >= w[1] && cy <= w[1] + w[3]) { out.push(items[k]); }
    }
    return out;
};
// layout.json の plan の付いた部品（素材01a〜dの切り抜きのグループ・太陽の線・配置図の文字と注・印・縮尺・用水路の矢印・配置図の題）と、
// 配置図の上の木田さんの物を、レイヤー「配置図」の一つのグループ「配置図（まとめ）」に入れる。中の部品は印を持ったまま（ダブルクリックで中に入って一つずつ動かせる）。
// 部品を入れてある小さなグループ（「配置図の注　…」「印　…」「縮尺」「配置図（切り抜き）」など）は、そのまま中へ。すでにまとめてあれば、まだ入っていない物だけ足す
SDY.groupPlan = function (doc, L) {
    var ids = {}, i, j, p, pg1 = -1;
    for (i = 0; i < L.pages.length; i++) {
        if (L.pages[i].no !== 1) { continue; }
        pg1 = i;
        for (j = 0; j < L.pages[i].parts.length; j++) { p = L.pages[i].parts[j]; if (p.plan) { ids[p.id] = j; } }
    }
    if (pg1 < 0) { return 0; }
    var lay = SDY.layer(doc, "配置図"), g = null, k, n = 0;
    try { var fig = doc.layers.getByName("図"); if (lay.zOrderPosition !== fig.zOrderPosition + 1) { lay.move(fig, ElementPlacement.PLACEBEFORE); } } catch (e) {}
    for (k = 0; k < doc.groupItems.length; k++) { if (doc.groupItems[k].name === SDY.PLAN_GROUP) { g = doc.groupItems[k]; break; } }
    if (!g) { g = lay.groupItems.add(); g.name = SDY.PLAN_GROUP; }
    var inG = function (it) { var q = it; while (q && q.typename !== "Layer") { if (q === g) { return true; } q = q.parent; } return false; };
    var topOf = function (it) {                       // レイヤーのすぐ下の階の入れ物（まとめのグループの中なら null）
        var q = it;
        while (q.parent && q.parent.typename === "GroupItem") { if (q.parent === g) { return null; } q = q.parent; }
        return q;
    };
    // 下から上へ：切り抜きのグループ（素材）→ 太陽の線 → 木田さんの物 → 文字・注・縮尺 → 印
    var rank = function (id) {
        if (id.indexOf("p1.sozai.01") === 0) { return 0; }
        if (id.indexOf("p1.link.13") === 0) { return 1; }
        if (id.indexOf("p1.mark.") === 0) { return 4; }
        return 3;
    };
    var map = SDY.findByTag(doc), lists = [[], [], [], [], []], id, it, t;
    for (id in ids) { if (ids.hasOwnProperty(id) && map[id]) { lists[rank(id)].push(map[id]); } }
    for (k = 0; k < SDY.planUser.length; k++) { lists[2].push(SDY.planUser[k]); }
    var r_, moved = [];
    for (r_ = 0; r_ < lists.length; r_++) {
        for (k = 0; k < lists[r_].length; k++) {
            it = lists[r_][k];
            try {
                if (inG(it)) { continue; }
                t = topOf(it); if (!t) { continue; }
                var seen = false, m;
                for (m = 0; m < moved.length; m++) { if (moved[m] === t) { seen = true; break; } }
                if (seen) { continue; }
                t.move(g, ElementPlacement.PLACEATBEGINNING);   // 後から入れた物が上
                moved.push(t); n++;
            } catch (e) { SDY.missing.push("配置図のまとめに入れられなかった：" + (it.name || it.typename) + "（" + e.message + "）"); }
        }
    }
    return n;
};

// 図面のまとめ（ユーザー 10-29 0:16：数字・文字・寸法線を一つずつ動かせるように、図と一緒にグループに）：
// layout.json の dwg の付いた部品（線だけのリンクの切り抜きのグループ、寸法・高さ・通り芯・部屋名・図名・注のグループや文字）を、
// レイヤー「図」の、図ごとのグループ（名前は dwg、メモに sdydwg:枚:名前）に入れる。リンクがいちばん下。すでに入っている物はそのまま
SDY.groupDrawings = function (doc, L) {
    var map = SDY.findByTag(doc), gs = {}, i, j, k, p, it, q, g, key, inside, n = 0, nt;
    var lay = SDY.layer(doc, "図");
    for (k = 0; k < doc.groupItems.length; k++) { nt = ""; try { nt = doc.groupItems[k].note; } catch (e0) {} if (nt && nt.indexOf("sdydwg:") === 0) { gs[nt.substring(7)] = doc.groupItems[k]; } }
    for (i = 0; i < L.pages.length; i++) {
        for (j = 0; j < L.pages[i].parts.length; j++) {
            p = L.pages[i].parts[j];
            if (!p.dwg || p.hidden) { continue; }
            it = map[p.id]; if (!it) { continue; }
            try {
                key = L.pages[i].no + ":" + p.dwg;
                g = gs[key];
                if (!g) { g = lay.groupItems.add(); g.name = p.dwg; g.note = "sdydwg:" + key; gs[key] = g; }
                q = it; inside = false;
                while (q.parent && q.parent.typename === "GroupItem") { if (q.parent === g) { inside = true; break; } q = q.parent; }
                if (inside) { continue; }
                q.move(g, ElementPlacement.PLACEATBEGINNING);   // 後から入れた物が上（リンクが先＝いちばん下）
                n++;
            } catch (e) { SDY.missing.push("図面のまとめに入れられなかった：" + p.id + "（" + e.message + "）"); }
        }
    }
    return n;
};
// layout.json に無くなった図面の部品（図が変わって寸法が無くなった・数が変わった、10-29）を .ai から外す。空になった寸法などのグループも
SDY.removeStaleDrawingParts = function (doc, L) {
    var ids = {}, i, j, map = SDY.findByTag(doc), id, it, rm = [], k, n = 0, nt, g;
    for (i = 0; i < L.pages.length; i++) { for (j = 0; j < L.pages[i].parts.length; j++) { ids[L.pages[i].parts[j].id] = true; } }
    for (id in map) { if (map.hasOwnProperty(id) && /^p\d+\.dwg\./.test(id) && !ids[id]) { rm.push(map[id]); } }
    for (k = 0; k < rm.length; k++) { try { rm[k].remove(); n++; } catch (e) {} }
    for (k = doc.groupItems.length - 1; k >= 0; k--) {
        g = doc.groupItems[k]; nt = "";
        try { nt = g.note; } catch (e1) {}
        if (nt && nt.indexOf("sdyg:") === 0 && g.pageItems.length === 0) { try { g.remove(); } catch (e2) {} }
    }
    return n;
};
